[
    {
       "step":"install huggingface CLI",
       "command":"pip3 -q install huggingface-hub[cli] \"numpy==$(python3 -c 'import numpy; print(numpy.__version__)')\""
    },
    {
      "step":"install onnxruntime",
      "command":"pip3 -q install onnxruntime-genai==0.5.2 \"numpy==$(python3 -c 'import numpy; print(numpy.__version__)')\""
    },
    {
       "step":"download model",
       "command":"hf download microsoft/Phi-3-mini-4k-instruct-onnx --include cpu_and_mobile/cpu-int4-rtn-block-32-acc-level-4/* --local-dir /pybox/model"
    }
]