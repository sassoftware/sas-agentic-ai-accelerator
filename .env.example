# Copy this file to .env and fill in your values, then run the mdb commands
# without passing these on the command line. Requires python-dotenv
# (pip install python-dotenv). The .env file is git-ignored — never commit real
# credentials. Precedence: CLI argument > environment variable > .env > default.

# --- Connection (used by every mdb Viya command) ---
SAS_VIYA_URL=example.sas.com
SAS_VIYA_USER=your-username
SAS_VIYA_PASSWORD=your-password
# Set to false only for a self-signed certificate SAS Viya does not recognize
SAS_VIYA_VERIFY_SSL=true

# --- mdb setup / register (SCR endpoint, deployment type, responsible party) ---
SAS_SCR_ENDPOINT=https://viya-host/llm
SAS_DEPLOYMENT_TYPE=k8s
SAS_RESPONSIBLE_PARTY=you@example.com
# Optional: embed a custom SAS Visual Analytics report on every model card as
# its "custom chart". Set the report URI (Reports > report > Copy link, the
# /reports/reports/<uuid> part); the host defaults to SAS_VIYA_URL. The report
# is chosen per model kind, so LLM and embedding models can carry different
# dashboards. Leave both blank to omit the model-card chart attributes.
# (The legacy SAS_MODEL_CARD_REPORT_URI is still honored as a fallback for both.)
# The example URI below is the shipped "LLM Usage Report" (SAS-Viya-Integrations/
# Logging-Monitoring/LLM Usage Report.json); see the Logging & Monitoring guide
# (website/docs/Administration-Guide/Logging-&-Monitoring.md) for how to import it.
# SAS_LLM_MODEL_CARD_REPORT_URI=/reports/reports/1f08db8d-d6c6-4ed1-9684-e7d11c4ec50c
# SAS_EMBEDDING_MODEL_CARD_REPORT_URI=/reports/reports/00000000-0000-0000-0000-000000000000

# --- mdb publish (default SCR publishing destination, overridable with -d) ---
SAS_PUBLISH_DESTINATION=llmACR

# --- mdb load-facts (upload the fact-sheet CSVs to CAS for the monitoring report) ---
# Target CAS library for the LLM_FACT_SHEET / EMBEDDING_FACT_SHEET tables (they
# are uploaded, promoted to global scope and saved to disk). Overridable with
# --caslib; defaults to Public. The CAS server defaults to cas-shared-default
# (auto-detected) and can be overridden with SAS_CAS_SERVER or --server.
SAS_CAS_LIBRARY=Public
# SAS_CAS_SERVER=cas-shared-default

# --- Model Definition Builder (mdb) provider API keys ---
# Used for live catalog browsing, `mdb validate --live` smoke tests and `mdb test`.
# Keys are only ever read from here or the environment - never written to any file.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
AZURE_OPENAI_API_KEY=
MISTRAL_API_KEY=

# --- Model Definition Builder (mdb) provider environment defaults ---
# Azure resource host: used as the wizard default and for live smoke tests. Any
# flavor works - myres.openai.azure.com, myres.cognitiveservices.azure.com,
# myres.services.ai.azure.com, or just 'myres' (expands to the classic host).
# Setting the SAME variable in a deployed SCR container points the model at
# that environment without a rebuild.
AZURE_OPENAI_RESOURCE=
# Azure API style: leave blank for the GA v1 endpoint (/openai/v1/...); set an
# API version (e.g. 2024-10-21 or 2025-01-01-preview) if your resource requires
# the legacy /openai/deployments/<name>/chat/completions?api-version=... route.
# Same wizard-default + container-override behavior as AZURE_OPENAI_RESOURCE.
AZURE_OPENAI_API_VERSION=

# Self-hosted OpenAI-compatible servers (Ollama / vLLM). The base URL is used for
# live catalog browsing and smoke tests; setting the SAME variable in a deployed
# SCR container points the model at that server without a rebuild. Leave the token
# blank for an open server (Ollama needs none; set vLLM's --api-key here if used).
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_API_KEY=

# --- Model Definition Builder (mdb) behavior ---
# MDB_OFFLINE=true          # no outbound calls: bundled catalogs + manual entry only
# MDB_VERIFY_SSL=false      # mirror of the -k convention for provider calls

# --- Model Definition Builder (mdb) working from your own repository ---
# Keep your definitions in your own git repo instead of the accelerator clone:
# MDB_DEFINITIONS names a root under which mdb creates its familiar layout as
# needed (LLM-Definitions/, Embedding-Definitions/, fact sheets, the retire
# _archive/ - gitignore that one). MDB_REPO must then point at the accelerator
# clone, which supplies the definition-core templates. mdb loads the .env of
# the directory you run it from, so put both in your own repo's .env.
# MDB_REPO=/path/to/sas-agentic-ai-accelerator
# MDB_DEFINITIONS=/path/to/your-repo
