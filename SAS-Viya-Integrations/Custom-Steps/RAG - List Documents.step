{"name": "RAG - List Documents.step", "displayName": "RAG - List Documents.step", "localDisplayName": "RAG - List Documents.step", "description": "Crawls a document folder, fingerprints every file and diffs it against the RAG ingestion ledger; outputs the document inventory for the RAG ingestion flow.", "localDescription": "Crawls a document folder, fingerprints every file and diffs it against the RAG ingestion ledger; outputs the document inventory for the RAG ingestion flow.", "properties": {}, "metadataVersion": 0.0, "version": 2, "type": "code", "flowMetadata": {"inputPorts": [], "outputPorts": [{"name": "_rgls_inventory", "displayName": "_rgls_inventory", "localDisplayName": "_rgls_inventory", "minEntries": 0, "maxEntries": 1, "defaultEntries": 0, "type": "table"}]}, "ui": "{\n\t\"showPageContentOnly\": true,\n\t\"pages\": [\n\t\t{\n\t\t\t\"id\": \"pageDefinition\",\n\t\t\t\"type\": \"page\",\n\t\t\t\"label\": \"Definition\",\n\t\t\t\"children\": [\n\t\t\t\t{\n\t\t\t\t\t\"id\": \"_rgls_info\",\n\t\t\t\t\t\"type\": \"text\",\n\t\t\t\t\t\"text\": \"Crawls a filesystem folder visible from this compute context, fingerprints every document and diffs it against the incremental-ingestion ledger. Only new and changed documents flow further down the RAG ingestion flow.\",\n\t\t\t\t\t\"visible\": \"\"\n\t\t\t\t},\n\t\t\t\t{\n\t\t\t\t\t\"id\": \"_rgls_sourcePath\",\n\t\t\t\t\t\"type\": \"textfield\",\n\t\t\t\t\t\"label\": \"Document folder (path on the compute server):\",\n\t\t\t\t\t\"placeholder\": \"/data/documents\",\n\t\t\t\t\t\"required\": true,\n\t\t\t\t\t\"visible\": \"\"\n\t\t\t\t},\n\t\t\t\t{\n\t\t\t\t\t\"id\": \"_rgls_pipelineVersion\",\n\t\t\t\t\t\"type\": \"textfield\",\n\t\t\t\t\t\"label\": \"Pipeline version (bump to force a full re-ingest):\",\n\t\t\t\t\t\"placeholder\": \"\",\n\t\t\t\t\t\"required\": false,\n\t\t\t\t\t\"visible\": \"\"\n\t\t\t\t},\n\t\t\t\t{\n\t\t\t\t\t\"id\": \"_rgls_sectionAdvanced\",\n\t\t\t\t\t\"type\": \"section\",\n\t\t\t\t\t\"label\": \"Runtime\",\n\t\t\t\t\t\"open\": false,\n\t\t\t\t\t\"visible\": \"\",\n\t\t\t\t\t\"children\": [\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"id\": \"_rgls_ledgerCaslib\",\n\t\t\t\t\t\t\t\"type\": \"textfield\",\n\t\t\t\t\t\t\t\"label\": \"Ledger caslib:\",\n\t\t\t\t\t\t\t\"placeholder\": \"\",\n\t\t\t\t\t\t\t\"required\": false,\n\t\t\t\t\t\t\t\"visible\": \"\"\n\t\t\t\t\t\t},\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"id\": \"_rgls_ledgerTable\",\n\t\t\t\t\t\t\t\"type\": \"textfield\",\n\t\t\t\t\t\t\t\"label\": \"Ledger table:\",\n\t\t\t\t\t\t\t\"placeholder\": \"\",\n\t\t\t\t\t\t\t\"required\": false,\n\t\t\t\t\t\t\t\"visible\": \"\"\n\t\t\t\t\t\t},\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"id\": \"_rgls_configHash\",\n\t\t\t\t\t\t\t\"type\": \"textfield\",\n\t\t\t\t\t\t\t\"label\": \"Config hash stamped into the ledger (blank = none; the scheduled job uses this as its drift guard):\",\n\t\t\t\t\t\t\t\"placeholder\": \"\",\n\t\t\t\t\t\t\t\"required\": false,\n\t\t\t\t\t\t\t\"visible\": \"\"\n\t\t\t\t\t\t},\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"id\": \"_rgls_ragCorePath\",\n\t\t\t\t\t\t\t\"type\": \"textfield\",\n\t\t\t\t\t\t\t\"label\": \"SAS Content folder holding rag_core:\",\n\t\t\t\t\t\t\t\"placeholder\": \"\",\n\t\t\t\t\t\t\t\"required\": false,\n\t\t\t\t\t\t\t\"visible\": \"\"\n\t\t\t\t\t\t}\n\t\t\t\t\t]\n\t\t\t\t},\n\t\t\t\t{\n\t\t\t\t\t\"id\": \"_rgls_inventory\",\n\t\t\t\t\t\"type\": \"outputtable\",\n\t\t\t\t\t\"label\": \"Document inventory output:\",\n\t\t\t\t\t\"required\": false,\n\t\t\t\t\t\"placeholder\": \"\",\n\t\t\t\t\t\"visible\": \"\"\n\t\t\t\t}\n\t\t\t]\n\t\t},\n\t\t{\n\t\t\t\"id\": \"pageAbout\",\n\t\t\t\"type\": \"page\",\n\t\t\t\"label\": \"About\",\n\t\t\t\"children\": [\n\t\t\t\t{\n\t\t\t\t\t\"id\": \"textAbout\",\n\t\t\t\t\t\"type\": \"text\",\n\t\t\t\t\t\"text\": \"RAG - List Documents step\\n==========\\n\\nCrawls a document source, computes a streaming SHA-256 per file and diffs it against the ledger: unchanged documents are skipped downstream, previously failed documents re-enter the pipeline, documents that disappeared are marked deleted so the Load step removes their chunks.\\n\\nFlow wiring: RAG - List Documents \u2192 RAG - Extract Text (inventory) \u2192 RAG - Chunk Documents (elements + updated inventory) \u2192 RAG - Embed Chunks (chunks) \u2192 RAG - Load Vector Store (embedded chunks + updated inventory). Always pass each step's UPDATED inventory forward so per-document failures and chunk counts reach the ledger.\",\n\t\t\t\t\t\"visible\": \"\"\n\t\t\t\t},\n\t\t\t\t{\n\t\t\t\t\t\"id\": \"sectionPrereqs\",\n\t\t\t\t\t\"type\": \"section\",\n\t\t\t\t\t\"label\": \"Pre-requisites\",\n\t\t\t\t\t\"open\": false,\n\t\t\t\t\t\"visible\": \"\",\n\t\t\t\t\t\"children\": [\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"id\": \"textPrereqs\",\n\t\t\t\t\t\t\t\"type\": \"text\",\n\t\t\t\t\t\t\t\"text\": \"Tested on SAS Viya 2026 (Stable).\\n\\n* The rag_core runtime must be deployed to SAS Content (default: /SAS Agentic AI Accelerator/RAG/rag_core) with deploy-rag-content.ps1/.sh - keep that folder read-only for regular users.\\n* The compute context's Python needs the requests package.\\n* CAS, for the ingestion ledger.\",\n\t\t\t\t\t\t\t\"visible\": \"\"\n\t\t\t\t\t\t}\n\t\t\t\t\t]\n\t\t\t\t},\n\t\t\t\t{\n\t\t\t\t\t\"id\": \"sectionDocumentation\",\n\t\t\t\t\t\"type\": \"section\",\n\t\t\t\t\t\"label\": \"Documentation\",\n\t\t\t\t\t\"open\": false,\n\t\t\t\t\t\"visible\": \"\",\n\t\t\t\t\t\"children\": [\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"id\": \"textDocumentation\",\n\t\t\t\t\t\t\t\"type\": \"text\",\n\t\t\t\t\t\t\t\"text\": \"The step refuses to run while a scheduled ingestion job holds a fresh run lock on the same ledger (locks older than 30 minutes are considered stale).\",\n\t\t\t\t\t\t\t\"visible\": \"\"\n\t\t\t\t\t\t}\n\t\t\t\t\t]\n\t\t\t\t},\n\t\t\t\t{\n\t\t\t\t\t\"id\": \"sectionChangelog\",\n\t\t\t\t\t\"type\": \"section\",\n\t\t\t\t\t\"label\": \"Changelog\",\n\t\t\t\t\t\"open\": true,\n\t\t\t\t\t\"visible\": \"\",\n\t\t\t\t\t\"children\": [\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"id\": \"textChangelog\",\n\t\t\t\t\t\t\t\"type\": \"text\",\n\t\t\t\t\t\t\t\"text\": \"* Version: 1.0 (28JUL2026)\\n      - Initial version\",\n\t\t\t\t\t\t\t\"visible\": \"\"\n\t\t\t\t\t\t}\n\t\t\t\t\t]\n\t\t\t\t}\n\t\t\t]\n\t\t}\n\t],\n\t\"syntaxversion\": \"1.3.0\",\n\t\"values\": {\n\t\t\"_rgls_sourcePath\": \"\",\n\t\t\"_rgls_pipelineVersion\": \"v1\",\n\t\t\"_rgls_ledgerCaslib\": \"casuser\",\n\t\t\"_rgls_ledgerTable\": \"RAG_INGESTION_LEDGER\",\n\t\t\"_rgls_configHash\": \"\",\n\t\t\"_rgls_ragCorePath\": \"/SAS Agentic AI Accelerator/RAG/rag_core\"\n\t}\n}", "templates": {"SAS": "/******************************************************************************\n * Copyright \u00a9 2026, SAS Institute Inc., Cary, NC, USA.  All Rights Reserved.\n * SPDX-License-Identifier: Apache-2.0\n *\n * RAG - List Documents: crawl a document source, fingerprint every file\n * (streaming SHA-256) and diff against the incremental-ingestion ledger.\n * Outputs the document inventory that drives the rest of the RAG flow.\n * Thin shell over rag_core.steps.run_list - see the About tab.\n ******************************************************************************/\n%macro _rgls_setup;\n    %if not %symexist(_rgls_inventory) %then %global _rgls_inventory;\n    %if %length(%superq(_rgls_inventory)) EQ 0 %then %let _rgls_inventory = WORK.RAG_INVENTORY;\n    %if not %symexist(_rgls_ledgerCaslib) %then %global _rgls_ledgerCaslib;\n    %if %length(%superq(_rgls_ledgerCaslib)) EQ 0 %then %let _rgls_ledgerCaslib = casuser;\n    %if not %symexist(_rgls_ledgerTable) %then %global _rgls_ledgerTable;\n    %if %length(%superq(_rgls_ledgerTable)) EQ 0 %then %let _rgls_ledgerTable = RAG_INGESTION_LEDGER;\n%mend _rgls_setup;\n%_rgls_setup;\n\n%let _rgls_viyaHost = %sysfunc(getoption(SERVICESBASEURL));\n%let _rgls_rc = 1;\n%let _rgls_error = The Python program did not run.;\n%let _rgls_summary = ;\n%let _rgls_nrows = 0;\n\n/* Read-only ledger snapshot (the run lock is the scheduled job's\n   discipline; this step only refuses to run beside a fresh lock). */\n%macro _rgls_ledger_export;\n    cas rglscas;\n    libname rglscl cas caslib=\"&_rgls_ledgerCaslib.\" sessref=rglscas;\n    %if %sysfunc(exist(rglscl.&_rgls_ledgerTable.)) %then %do;\n        filename rglsled \"%sysfunc(pathname(work))/rgls_ledger_in.json\";\n        proc json out=rglsled noSASTags;\n            export rglscl.&_rgls_ledgerTable.;\n        run; quit;\n        filename rglsled clear;\n    %end;\n    libname rglscl clear;\n    cas rglscas terminate;\n%mend _rgls_ledger_export;\n%_rgls_ledger_export;\n\nproc python restart;\nsubmit;\ndef main():\n    import json\n    import os\n    import sys\n    import tempfile\n    import time\n    import traceback\n\n    def sas_safe(text):\n        \"\"\"Strings crossing into SAS.logMessage/SAS.symput are embedded into\n        generated SAS statements - quotes and macro characters corrupt the\n        code stream (verified live). EVERY such string goes through here.\"\"\"\n        cleaned = str(text)\n        for ch in (\"'\", '\"', \"%\", \"&\", \";\"):\n            cleaned = cleaned.replace(ch, \" \")\n        return cleaned\n\n    def M(msg):\n        SAS.logMessage(\"RAGLIST \" + sas_safe(msg))\n\n    try:\n        import requests\n    except Exception:\n        SAS.symput(\"_rgls_error\", \"The Python environment of this compute \"\n                                   \"context lacks the requests package - see \"\n                                   \"the RAG administration guide.\")\n        return\n\n    BASE = str(SAS.symget(\"_rgls_viyaHost\") or \"\").rstrip(\"/\")\n    TOKEN = os.environ.get(\"SAS_SERVICES_TOKEN\", \"\")\n    AUTH = {\"Authorization\": \"Bearer \" + TOKEN}\n    VERIFY = os.environ.get(\"SSLCALISTLOC\") or os.environ.get(\"CAS_CLIENT_SSL_CA_LIST\") or True\n    WORKPATH = SAS.workpath if SAS.workpath.endswith(os.sep) else SAS.workpath + os.sep\n\n    P = {name: str(SAS.symget(name) or \"\").strip() for name in [\n        \"_rgls_sourcePath\",\n        \"_rgls_pipelineVersion\",\n        \"_rgls_configHash\",\n        \"_rgls_ragCorePath\",\n    ]}\n\n    def read_rows(filename, missing_message):\n        path = WORKPATH + filename\n        if not os.path.exists(path):\n            raise RuntimeError(missing_message)\n        with open(path, \"r\", encoding=\"utf-8\") as fh:\n            data = json.load(fh)\n        rows = []\n        for row in data if isinstance(data, list) else []:\n            rows.append({str(k).lower(): v for k, v in row.items()})\n        return rows\n\n    def write_rows(filename, rows, columns, numeric=()):\n        out = []\n        for row in rows:\n            rec = {}\n            for column in columns:\n                value = row.get(column)\n                if column in numeric:\n                    try:\n                        rec[column] = float(value or 0)\n                    except Exception:\n                        rec[column] = 0.0\n                else:\n                    rec[column] = \"\" if value is None else str(value)\n            out.append(rec)\n        with open(WORKPATH + filename, \"w\", encoding=\"utf-8\") as fh:\n            json.dump(out, fh)\n        return len(out)\n\n    try:\n        # ---- rag_core bootstrap: download the governed SAS Content folder --\n        def get_json(endpoint, **params):\n            response = requests.get(BASE + endpoint, params=params, headers=AUTH,\n                                    verify=VERIFY, timeout=(5, 30))\n            response.raise_for_status()\n            return response.json()\n\n        def download_folder(folder_id, local_dir):\n            os.makedirs(local_dir, exist_ok=True)\n            count = 0\n            members = get_json(f\"/folders/folders/{folder_id}/members\", limit=200)\n            for member in members.get(\"items\", []):\n                uri = member.get(\"uri\", \"\")\n                if \"/files/files/\" in uri:\n                    content = requests.get(BASE + uri + \"/content\", headers=AUTH,\n                                           verify=VERIFY, timeout=(5, 60))\n                    content.raise_for_status()\n                    with open(os.path.join(local_dir, member[\"name\"]), \"wb\") as fh:\n                        fh.write(content.content)\n                    count += 1\n                elif \"/folders/folders/\" in uri:\n                    count += download_folder(uri.rsplit(\"/\", 1)[-1],\n                                             os.path.join(local_dir, member[\"name\"]))\n            return count\n\n        core_path = P[\"_rgls_ragCorePath\"] or \"/SAS Agentic AI Accelerator/RAG/rag_core\"\n        root = requests.get(BASE + \"/folders/folders/@item\",\n                            params={\"path\": core_path}, headers=AUTH,\n                            verify=VERIFY, timeout=(5, 30))\n        if root.status_code != 200:\n            raise RuntimeError(f\"rag_core folder {core_path} not found \"\n                               f\"(HTTP {root.status_code}) - deploy it per the \"\n                               \"administration guide\")\n        staging = tempfile.mkdtemp(prefix=\"rag_core_\")\n        n_files = download_folder(root.json()[\"id\"], os.path.join(staging, \"rag_core\"))\n        sys.path.insert(0, staging)\n        import rag_core\n        M(f\"rag_core {rag_core.RAG_CORE_VERSION} bootstrapped ({n_files} files)\")\n\n        from rag_core.steps import LEDGER_COLUMNS, run_list\n\n        inventory_columns = LEDGER_COLUMNS + [\"extractor\"]\n        if not P[\"_rgls_sourcePath\"]:\n            raise RuntimeError(\"required parameter sourcePath is missing\")\n\n        ledger = []\n        if os.path.exists(WORKPATH + \"rgls_ledger_in.json\"):\n            for row in read_rows(\"rgls_ledger_in.json\", \"unreachable\"):\n                ledger.append({column: row.get(column, \"\")\n                               for column in inventory_columns})\n        real_rows = [r for r in ledger if r.get(\"doc_id\") != \"__run_lock__\"]\n        lock_rows = [r for r in ledger if r.get(\"doc_id\") == \"__run_lock__\"]\n        if lock_rows:\n            try:\n                held_for = time.time() - float(lock_rows[0].get(\"mtime\") or 0)\n            except Exception:\n                held_for = 1e9\n            if held_for < 1800:\n                raise RuntimeError(\"a scheduled ingestion run appears active on \"\n                                   \"this ledger (run lock held) - retry later\")\n            M(\"stale run lock ignored (held longer than 30 minutes)\")\n\n        run_id = f\"run-{int(time.time())}\"\n        inventory = run_list(P[\"_rgls_sourcePath\"], real_rows, run_id,\n                             P[\"_rgls_pipelineVersion\"] or \"v1\",\n                             P[\"_rgls_configHash\"], log=M)\n        n_rows = write_rows(\"rgls_inventory_out.json\", inventory,\n                            inventory_columns, numeric=(\"chunk_count\",))\n        SAS.symput(\"_rgls_nrows\", str(n_rows))\n        pending = sum(1 for r in inventory if r.get(\"status\") in (\"new\", \"changed\"))\n        summary = (f\"run {run_id}: {n_rows} documents, {pending} new or changed \"\n                   f\"(previous ledger: {len(real_rows)} documents)\")\n        M(summary)\n        SAS.symput(\"_rgls_summary\", sas_safe(summary)[:400])\n\n        SAS.symput(\"_rgls_rc\", \"0\")\n    except Exception as error:\n        error_text = f\"{type(error).__name__}: {error}\"\n        M(\"failed: \" + sas_safe(error_text))\n        print(traceback.format_exc())\n        SAS.symput(\"_rgls_error\", sas_safe(error_text)[:500])\n\n\nmain()\nendsubmit;\nrun; quit;\nproc python terminate;\nrun; quit;\n\n%macro _rgls_emit_inventory;\n    %if &_rgls_rc. NE 0 %then %return;\n    %if &_rgls_nrows. GT 0 %then %do;\n        filename rglsino \"%sysfunc(pathname(work))/rgls_inventory_out.json\";\n        libname rglsinj json fileref=rglsino;\n        data &_rgls_inventory.(compress=yes);\n            length doc_id $ 40 source_uri $ 1024 source_kind $ 16\n                   content_hash $ 64 mtime $ 32 status $ 12 error_text $ 512\n                   pipeline_version $ 32 config_hash $ 32 chunk_count 8\n                   run_id $ 32 updated_at $ 24 extractor $ 64;\n            set rglsinj.root(drop=ordinal_root);\n        run;\n        libname rglsinj clear;\n        filename rglsino clear;\n    %end;\n    %else %do;\n        data &_rgls_inventory.(compress=yes);\n            length doc_id $ 40 source_uri $ 1024 source_kind $ 16\n                   content_hash $ 64 mtime $ 32 status $ 12 error_text $ 512\n                   pipeline_version $ 32 config_hash $ 32 chunk_count 8\n                   run_id $ 32 updated_at $ 24 extractor $ 64;\n            call missing(of _all_);\n            stop;\n        run;\n    %end;\n%mend _rgls_emit_inventory;\n%_rgls_emit_inventory;\n\ndata _null_;\n    if \"&_rgls_rc.\" ne \"0\" then do;\n        putLog \"ERROR: RAG - List Documents failed: %superq(_rgls_error)\";\n        abort 42;\n    end;\n    putLog \"NOTE: RAG - List Documents: %superq(_rgls_summary)\";\nrun;"}}