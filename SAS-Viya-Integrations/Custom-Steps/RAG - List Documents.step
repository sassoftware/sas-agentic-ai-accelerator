{"description": "Crawls a document folder, fingerprints every file and diffs it against the RAG ingestion ledger; outputs the document inventory for the RAG ingestion flow.", "displayName": "RAG - List Documents.step", "flowMetadata": {"inputPorts": [], "outputPorts": [{"name": "_rgls_inventory", "displayName": "_rgls_inventory", "minEntries": 1, "maxEntries": 1, "columnDelta": null, "type": "table"}]}, "metadataVersion": 1, "name": "RAG - List Documents.step", "properties": {}, "templates": {"SAS": "/******************************************************************************\n * Copyright \u00a9 2026, SAS Institute Inc., Cary, NC, USA.  All Rights Reserved.\n * SPDX-License-Identifier: Apache-2.0\n *\n * RAG - List Documents: crawl a document source, fingerprint every file\n * (streaming SHA-256) and diff against the incremental-ingestion ledger\n * (the promoted CAS table <project>_LEDGER in the tables caslib).\n * Outputs the document inventory that chains through the RAG flow.\n * Thin shell over rag_core.steps.run_list - see the About tab.\n ******************************************************************************/\n%macro _rgls_setup;\n    %if not %symexist(_rgls_inventory) %then %global _rgls_inventory;\n    %if %length(%superq(_rgls_inventory)) EQ 0 %then %let _rgls_inventory = WORK.RAG_INVENTORY;\n    %if not %symexist(_rgls_ragProject) %then %global _rgls_ragProject;\n    %if not %symexist(_rgls_tablesCaslib) %then %global _rgls_tablesCaslib;\n    %if %length(%superq(_rgls_tablesCaslib)) EQ 0 %then %let _rgls_tablesCaslib = casuser;\n%mend _rgls_setup;\n%_rgls_setup;\n\n%let _rgls_viyaHost = %sysfunc(getoption(SERVICESBASEURL));\n%let _rgls_rc = 1;\n%let _rgls_error = The Python program did not run.;\n%let _rgls_summary = ;\n%let _rgls_nrows = 0;\n\n/* One CAS session for the whole step: created here, reused by\n   SWAT inside proc python, promote+save done by proc casutil. */\ncas rglscas uuidmac=_rgls_casuuid;\n%let _rgls_cashost = %sysfunc(getoption(CASHOST));\n%let _rgls_casport = %sysfunc(getoption(CASPORT));\n\nproc python restart;\nsubmit;\ndef main():\n    import json\n    import os\n    import sys\n    import tempfile\n    import time\n    import traceback\n\n    def sas_safe(text):\n        \"\"\"Strings crossing into SAS.logMessage/SAS.symput are embedded into\n        generated SAS statements - quotes and macro characters corrupt the\n        code stream (verified live). EVERY such string goes through here.\"\"\"\n        cleaned = str(text)\n        for ch in (\"'\", '\"', \"%\", \"&\", \";\"):\n            cleaned = cleaned.replace(ch, \" \")\n        return cleaned\n\n    def M(msg):\n        SAS.logMessage(\"RAGLIST \" + sas_safe(msg))\n\n    try:\n        import requests\n    except Exception:\n        SAS.symput(\"_rgls_error\", \"The Python environment of this compute \"\n                                   \"context lacks the requests package - see \"\n                                   \"the RAG administration guide.\")\n        return\n    try:\n        import pandas as pd\n        import swat\n    except Exception:\n        SAS.symput(\"_rgls_error\", \"The Python environment of this compute \"\n                                   \"context lacks the swat/pandas packages \"\n                                   \"required for the CAS table transport - \"\n                                   \"see the RAG administration guide.\")\n        return\n\n    BASE = str(SAS.symget(\"_rgls_viyaHost\") or \"\").rstrip(\"/\")\n    TOKEN = os.environ.get(\"SAS_SERVICES_TOKEN\", \"\")\n    AUTH = {\"Authorization\": \"Bearer \" + TOKEN}\n    VERIFY = os.environ.get(\"SSLCALISTLOC\") or os.environ.get(\"CAS_CLIENT_SSL_CA_LIST\") or True\n    WORKPATH = SAS.workpath if SAS.workpath.endswith(os.sep) else SAS.workpath + os.sep\n\n    P = {name: str(SAS.symget(name) or \"\").strip() for name in [\n        \"_rgls_sourcePath\",\n        \"_rgls_pipelineVersion\",\n        \"_rgls_configHash\",\n        \"_rgls_ragProject\",\n        \"_rgls_tablesCaslib\",\n        \"_rgls_ragCorePath\",\n    ]}\n\n    def read_rows(filename, missing_message):\n        path = WORKPATH + filename\n        if not os.path.exists(path):\n            raise RuntimeError(missing_message)\n        with open(path, \"r\", encoding=\"utf-8\") as fh:\n            data = json.load(fh)\n        rows = []\n        for row in data if isinstance(data, list) else []:\n            rows.append({str(k).lower(): v for k, v in row.items()})\n        return rows\n\n    def clean_path(raw, kind):\n        \"\"\"Path-selector values arrive scheme-prefixed (sasserver:/...,\n        sascontent:/...). Server-filesystem consumers reject SAS Content\n        picks with a clear message instead of a downstream ENOENT.\"\"\"\n        value = str(raw or \"\").strip()\n        lowered = value.lower()\n        if lowered.startswith(\"sascontent:\"):\n            if kind == \"server\":\n                raise RuntimeError(\n                    \"a SAS Content folder was selected - pick a folder on \"\n                    \"the compute server file system (SAS Content sources \"\n                    \"arrive with a later release)\")\n            return value[len(\"sascontent:\"):]\n        if lowered.startswith(\"sasserver:\"):\n            return value[len(\"sasserver:\"):]\n        return value\n\n    def write_rows(filename, rows, columns, numeric=()):\n        out = []\n        for row in rows:\n            rec = {}\n            for column in columns:\n                value = row.get(column)\n                if column in numeric:\n                    try:\n                        rec[column] = float(value or 0)\n                    except Exception:\n                        rec[column] = 0.0\n                else:\n                    rec[column] = \"\" if value is None else str(value)\n            out.append(rec)\n        with open(WORKPATH + filename, \"w\", encoding=\"utf-8\") as fh:\n            json.dump(out, fh)\n        return len(out)\n\n    try:\n        # ---- CAS: reuse the session the step created in SAS ---------------\n        # (sas-studio-custom-steps: Reuse-CAS-session-from-SWAT)\n        import re as _re\n        os.environ.setdefault(\"CAS_CLIENT_SSL_CA_LIST\",\n                              os.environ.get(\"SSLCALISTLOC\", \"\"))\n        conn = swat.CAS(hostname=str(SAS.symget(\"_rgls_cashost\") or \"\"),\n                        port=int(float(SAS.symget(\"_rgls_casport\") or 5570)),\n                        password=TOKEN,\n                        session=str(SAS.symget(\"_rgls_casuuid\") or \"\"))\n        CASLIB = P[\"_rgls_tablesCaslib\"] or \"casuser\"\n        if not _re.match(r\"^[A-Za-z][A-Za-z0-9_]{0,19}$\",\n                         P[\"_rgls_ragProject\"] or \"\"):\n            raise RuntimeError(\n                \"ragProject must be 1-20 characters (letters, digits, \"\n                \"underscores, starting with a letter) so every \"\n                \"project_suffix table name stays within the 32 characters \"\n                \"SAS Studio displays\")\n\n        def project_table(suffix):\n            return P[\"_rgls_ragProject\"] + suffix\n\n        def cas_read(name, required_message=None):\n            \"\"\"Read a pipeline table into lower-cased row dicts; absent\n            table = empty (the pipeline's empty state) unless required.\"\"\"\n            if not conn.table.tableExists(caslib=CASLIB, name=name).exists:\n                if required_message:\n                    raise RuntimeError(required_message)\n                return []\n            frame = conn.CASTable(name, caslib=CASLIB).to_frame()\n            rows = []\n            for record in frame.to_dict(\"records\"):\n                row = {}\n                for key, value in record.items():\n                    row[str(key).lower()] = None if pd.isna(value) else value\n                rows.append(row)\n            return rows\n\n        def cas_stage(name, rows, columns, numeric=()):\n            \"\"\"Upload the session-scope staging table <name>_S with varchar\n            columns (no 32k limit); the SAS side swaps it into the promoted\n            global table and saves it, so the previous state survives a\n            mid-step failure.\"\"\"\n            if not rows:\n                return 0\n            data = []\n            for row in rows:\n                rec = []\n                for column in columns:\n                    value = row.get(column)\n                    if column in numeric:\n                        try:\n                            rec.append(float(value or 0))\n                        except Exception:\n                            rec.append(0.0)\n                    else:\n                        rec.append(\"\" if value is None else str(value))\n                data.append(rec)\n            frame = pd.DataFrame(data, columns=list(columns))\n            spec = [{\"name\": column,\n                     \"type\": \"double\" if column in numeric else \"varchar\"}\n                    for column in columns]\n            conn.upload_frame(frame,\n                              casout={\"name\": name + \"_S\", \"caslib\": CASLIB,\n                                      \"replace\": True},\n                              importoptions={\"fileType\": \"csv\",\n                                             \"allowEmbeddedNewLines\": True,\n                                             \"vars\": spec})\n            return len(rows)\n\n        # ---- rag_core bootstrap: download the governed SAS Content folder --\n        def get_json(endpoint, **params):\n            response = requests.get(BASE + endpoint, params=params, headers=AUTH,\n                                    verify=VERIFY, timeout=(5, 30))\n            response.raise_for_status()\n            return response.json()\n\n        def download_folder(folder_id, local_dir):\n            os.makedirs(local_dir, exist_ok=True)\n            count = 0\n            members = get_json(f\"/folders/folders/{folder_id}/members\", limit=200)\n            for member in members.get(\"items\", []):\n                uri = member.get(\"uri\", \"\")\n                if \"/files/files/\" in uri:\n                    content = requests.get(BASE + uri + \"/content\", headers=AUTH,\n                                           verify=VERIFY, timeout=(5, 60))\n                    content.raise_for_status()\n                    with open(os.path.join(local_dir, member[\"name\"]), \"wb\") as fh:\n                        fh.write(content.content)\n                    count += 1\n                elif \"/folders/folders/\" in uri:\n                    count += download_folder(uri.rsplit(\"/\", 1)[-1],\n                                             os.path.join(local_dir, member[\"name\"]))\n            return count\n\n        core_path = (clean_path(P[\"_rgls_ragCorePath\"], \"content\")\n                     or \"/SAS Agentic AI Accelerator/RAG/rag_core\")\n        root = requests.get(BASE + \"/folders/folders/@item\",\n                            params={\"path\": core_path}, headers=AUTH,\n                            verify=VERIFY, timeout=(5, 30))\n        if root.status_code != 200:\n            raise RuntimeError(f\"rag_core folder {core_path} not found \"\n                               f\"(HTTP {root.status_code}) - deploy it per the \"\n                               \"administration guide\")\n        staging = tempfile.mkdtemp(prefix=\"rag_core_\")\n        n_files = download_folder(root.json()[\"id\"], os.path.join(staging, \"rag_core\"))\n        sys.path.insert(0, staging)\n        import rag_core\n        M(f\"rag_core {rag_core.RAG_CORE_VERSION} bootstrapped ({n_files} files)\")\n\n        from rag_core.steps import LEDGER_COLUMNS, run_list\n\n        inventory_columns = LEDGER_COLUMNS + [\"extractor\"]\n        source_path = clean_path(P[\"_rgls_sourcePath\"], \"server\")\n        if not source_path:\n            raise RuntimeError(\"required parameter sourcePath is missing\")\n\n        ledger = []\n        for row in cas_read(project_table(\"_LEDGER\")):\n            ledger.append({column: (\"\" if row.get(column) is None\n                                    else row.get(column))\n                           for column in inventory_columns})\n        real_rows = [r for r in ledger if r.get(\"doc_id\") != \"__run_lock__\"]\n        lock_rows = [r for r in ledger if r.get(\"doc_id\") == \"__run_lock__\"]\n        if lock_rows:\n            try:\n                held_for = time.time() - float(lock_rows[0].get(\"mtime\") or 0)\n            except Exception:\n                held_for = 1e9\n            if held_for < 1800:\n                raise RuntimeError(\"a scheduled ingestion run appears active on \"\n                                   \"this ledger (run lock held) - retry later\")\n            M(\"stale run lock ignored (held longer than 30 minutes)\")\n\n        run_id = f\"run-{int(time.time())}\"\n        inventory = run_list(source_path, real_rows, run_id,\n                             P[\"_rgls_pipelineVersion\"] or \"v1\",\n                             P[\"_rgls_configHash\"], log=M)\n        n_rows = write_rows(\"rgls_inventory_out.json\", inventory,\n                            inventory_columns, numeric=(\"chunk_count\",))\n        SAS.symput(\"_rgls_nrows\", str(n_rows))\n        pending = sum(1 for r in inventory if r.get(\"status\") in (\"new\", \"changed\"))\n        summary = (f\"run {run_id}: {n_rows} documents, {pending} new or changed \"\n                   f\"(previous ledger: {len(real_rows)} documents)\")\n        M(summary)\n        SAS.symput(\"_rgls_summary\", sas_safe(summary)[:400])\n\n        try:\n            conn.close(close_session=False)\n        except Exception:\n            pass\n        SAS.symput(\"_rgls_rc\", \"0\")\n    except Exception as error:\n        error_text = f\"{type(error).__name__}: {error}\"\n        M(\"failed: \" + sas_safe(error_text))\n        print(traceback.format_exc())\n        SAS.symput(\"_rgls_error\", sas_safe(error_text)[:500])\n\n\nmain()\nendsubmit;\nrun; quit;\nproc python terminate;\nrun; quit;\n\ncas rglscas terminate;\n\n%macro _rgls_emit_inventory;\n    %if &_rgls_rc. NE 0 %then %return;\n    %if &_rgls_nrows. GT 0 %then %do;\n        filename rglsino \"%sysfunc(pathname(work))/rgls_inventory_out.json\";\n        libname rglsinj json fileref=rglsino;\n        data &_rgls_inventory.(compress=yes);\n            length doc_id $ 40 source_uri $ 1024 source_kind $ 16\n                   content_hash $ 64 mtime $ 32 status $ 12 error_text $ 512\n                   pipeline_version $ 32 config_hash $ 32 chunk_count 8\n                   run_id $ 32 updated_at $ 24 extractor $ 64;\n            set rglsinj.root(drop=ordinal_root);\n        run;\n        libname rglsinj clear;\n        filename rglsino clear;\n    %end;\n    %else %do;\n        data &_rgls_inventory.(compress=yes);\n            length doc_id $ 40 source_uri $ 1024 source_kind $ 16\n                   content_hash $ 64 mtime $ 32 status $ 12 error_text $ 512\n                   pipeline_version $ 32 config_hash $ 32 chunk_count 8\n                   run_id $ 32 updated_at $ 24 extractor $ 64;\n            call missing(of _all_);\n            stop;\n        run;\n    %end;\n%mend _rgls_emit_inventory;\n%_rgls_emit_inventory;\n\ndata _null_;\n    if \"&_rgls_rc.\" ne \"0\" then do;\n        putLog \"ERROR: RAG - List Documents failed: %superq(_rgls_error)\";\n        abort 42;\n    end;\n    putLog \"NOTE: RAG - List Documents: %superq(_rgls_summary)\";\nrun;"}, "type": "code", "ui": "{\n\t\"showPageContentOnly\": true,\n\t\"pages\": [\n\t\t{\n\t\t\t\"id\": \"pageDefinition\",\n\t\t\t\"type\": \"page\",\n\t\t\t\"label\": \"Definition\",\n\t\t\t\"children\": [\n\t\t\t\t{\n\t\t\t\t\t\"id\": \"_rgls_info\",\n\t\t\t\t\t\"type\": \"text\",\n\t\t\t\t\t\"text\": \"Crawls a filesystem folder visible from this compute context, fingerprints every document and diffs it against the incremental-ingestion ledger (<project>_LEDGER). Only new and changed documents flow further down the RAG ingestion flow.\",\n\t\t\t\t\t\"visible\": \"\"\n\t\t\t\t},\n\t\t\t\t{\n\t\t\t\t\t\"id\": \"_rgls_sourcePath\",\n\t\t\t\t\t\"type\": \"path\",\n\t\t\t\t\t\"label\": \"Document folder (on the compute server file system):\",\n\t\t\t\t\t\"pathtype\": \"folder\",\n\t\t\t\t\t\"placeholder\": \"\",\n\t\t\t\t\t\"required\": true,\n\t\t\t\t\t\"visible\": \"\"\n\t\t\t\t},\n\t\t\t\t{\n\t\t\t\t\t\"id\": \"_rgls_ragProject\",\n\t\t\t\t\t\"type\": \"textfield\",\n\t\t\t\t\t\"label\": \"RAG project name (prefix of every pipeline table, max 20 characters):\",\n\t\t\t\t\t\"placeholder\": \"e.g. RAG_HR\",\n\t\t\t\t\t\"required\": true,\n\t\t\t\t\t\"visible\": \"\"\n\t\t\t\t},\n\t\t\t\t{\n\t\t\t\t\t\"id\": \"_rgls_tablesCaslib\",\n\t\t\t\t\t\"type\": \"textfield\",\n\t\t\t\t\t\"label\": \"Caslib where the pipeline tables are stored:\",\n\t\t\t\t\t\"placeholder\": \"\",\n\t\t\t\t\t\"required\": false,\n\t\t\t\t\t\"visible\": \"\"\n\t\t\t\t},\n\t\t\t\t{\n\t\t\t\t\t\"id\": \"_rgls_pipelineVersion\",\n\t\t\t\t\t\"type\": \"textfield\",\n\t\t\t\t\t\"label\": \"Pipeline version (bump to force a full re-ingest):\",\n\t\t\t\t\t\"placeholder\": \"\",\n\t\t\t\t\t\"required\": false,\n\t\t\t\t\t\"visible\": \"\"\n\t\t\t\t},\n\t\t\t\t{\n\t\t\t\t\t\"id\": \"_rgls_sectionAdvanced\",\n\t\t\t\t\t\"type\": \"section\",\n\t\t\t\t\t\"label\": \"Runtime\",\n\t\t\t\t\t\"open\": false,\n\t\t\t\t\t\"visible\": \"\",\n\t\t\t\t\t\"children\": [\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"id\": \"_rgls_configHash\",\n\t\t\t\t\t\t\t\"type\": \"textfield\",\n\t\t\t\t\t\t\t\"label\": \"Config hash stamped into the ledger (blank = none; the scheduled job uses this as its drift guard):\",\n\t\t\t\t\t\t\t\"placeholder\": \"\",\n\t\t\t\t\t\t\t\"required\": false,\n\t\t\t\t\t\t\t\"visible\": \"\"\n\t\t\t\t\t\t},\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"id\": \"_rgls_ragCorePath\",\n\t\t\t\t\t\t\t\"type\": \"path\",\n\t\t\t\t\t\t\t\"label\": \"SAS Content folder holding rag_core:\",\n\t\t\t\t\t\t\t\"pathtype\": \"folder\",\n\t\t\t\t\t\t\t\"placeholder\": \"\",\n\t\t\t\t\t\t\t\"required\": false,\n\t\t\t\t\t\t\t\"visible\": \"\"\n\t\t\t\t\t\t}\n\t\t\t\t\t]\n\t\t\t\t},\n\t\t\t\t{\n\t\t\t\t\t\"id\": \"_rgls_inventory\",\n\t\t\t\t\t\"type\": \"outputtable\",\n\t\t\t\t\t\"label\": \"Document inventory output:\",\n\t\t\t\t\t\"required\": false,\n\t\t\t\t\t\"placeholder\": \"\",\n\t\t\t\t\t\"visible\": \"\"\n\t\t\t\t}\n\t\t\t]\n\t\t},\n\t\t{\n\t\t\t\"id\": \"pageAbout\",\n\t\t\t\"type\": \"page\",\n\t\t\t\"label\": \"About\",\n\t\t\t\"children\": [\n\t\t\t\t{\n\t\t\t\t\t\"id\": \"textAbout\",\n\t\t\t\t\t\"type\": \"text\",\n\t\t\t\t\t\"text\": \"RAG - List Documents step\\n==========\\n\\nCrawls a document source, computes a streaming SHA-256 per file and diffs it against the ledger: unchanged documents are skipped downstream, previously failed documents re-enter the pipeline, documents that disappeared are marked deleted so the Load step removes their chunks. The ledger is the promoted CAS table <project>_LEDGER, written by the Load step (promote + save).\\n\\nFlow wiring: chain the document INVENTORY through every step - RAG - List Documents \u2192 Extract Text \u2192 Chunk Documents \u2192 Embed Chunks \u2192 Load Vector Store. The bulk data travels beside the flow in promoted CAS tables named <project>_ELEMENTS, <project>_CHUNKS, <project>_EMBEDDED and <project>_LEDGER in the tables caslib (each saved to disk, so state survives server restarts; names stay within 32 characters so they display nicely in SAS Studio). Give every step the SAME project name and caslib.\",\n\t\t\t\t\t\"visible\": \"\"\n\t\t\t\t},\n\t\t\t\t{\n\t\t\t\t\t\"id\": \"sectionPrereqs\",\n\t\t\t\t\t\"type\": \"section\",\n\t\t\t\t\t\"label\": \"Pre-requisites\",\n\t\t\t\t\t\"open\": false,\n\t\t\t\t\t\"visible\": \"\",\n\t\t\t\t\t\"children\": [\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"id\": \"textPrereqs\",\n\t\t\t\t\t\t\t\"type\": \"text\",\n\t\t\t\t\t\t\t\"text\": \"Tested on SAS Viya 2026 (Stable).\\n\\n* The rag_core runtime must be deployed to SAS Content (default: /SAS Agentic AI Accelerator/RAG/rag_core) with deploy-rag-content.ps1/.sh - keep that folder read-only for regular users.\\n* The compute context's Python needs the requests, swat and pandas packages (swat/pandas carry the pipeline tables to CAS - varchar columns, no 32k limit).\\n* CAS available; the runner needs write access to the tables caslib.\",\n\t\t\t\t\t\t\t\"visible\": \"\"\n\t\t\t\t\t\t}\n\t\t\t\t\t]\n\t\t\t\t},\n\t\t\t\t{\n\t\t\t\t\t\"id\": \"sectionDocumentation\",\n\t\t\t\t\t\"type\": \"section\",\n\t\t\t\t\t\"label\": \"Documentation\",\n\t\t\t\t\t\"open\": false,\n\t\t\t\t\t\"visible\": \"\",\n\t\t\t\t\t\"children\": [\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"id\": \"textDocumentation\",\n\t\t\t\t\t\t\t\"type\": \"text\",\n\t\t\t\t\t\t\t\"text\": \"The step refuses to run while a scheduled ingestion job holds a fresh run lock on the same ledger (locks older than 30 minutes are considered stale).\",\n\t\t\t\t\t\t\t\"visible\": \"\"\n\t\t\t\t\t\t}\n\t\t\t\t\t]\n\t\t\t\t},\n\t\t\t\t{\n\t\t\t\t\t\"id\": \"sectionChangelog\",\n\t\t\t\t\t\"type\": \"section\",\n\t\t\t\t\t\"label\": \"Changelog\",\n\t\t\t\t\t\"open\": true,\n\t\t\t\t\t\"visible\": \"\",\n\t\t\t\t\t\"children\": [\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"id\": \"textChangelog\",\n\t\t\t\t\t\t\t\"type\": \"text\",\n\t\t\t\t\t\t\t\"text\": \"* Version: 1.1 (28JUL2026)\\n      - Pipeline tables move to promoted CAS tables via SWAT (varchar, no 32k limit); automatic embed checkpoint\\n* Version: 1.0 (28JUL2026)\\n      - Initial version\",\n\t\t\t\t\t\t\t\"visible\": \"\"\n\t\t\t\t\t\t}\n\t\t\t\t\t]\n\t\t\t\t}\n\t\t\t]\n\t\t}\n\t],\n\t\"syntaxversion\": \"1.3.0\",\n\t\"values\": {\n\t\t\"_rgls_ragProject\": \"\",\n\t\t\"_rgls_tablesCaslib\": \"casuser\",\n\t\t\"_rgls_ragCorePath\": \"/SAS Agentic AI Accelerator/RAG/rag_core\",\n\t\t\"_rgls_sourcePath\": \"\",\n\t\t\"_rgls_pipelineVersion\": \"v1\",\n\t\t\"_rgls_configHash\": \"\"\n\t}\n}"}