{"description": "Token-aware chunking of extracted RAG elements with deterministic chunk ids; chunk size is budgeted inside the embedding model's token window.", "displayName": "RAG - Chunk Documents.step", "flowMetadata": {"inputPorts": [{"name": "_rgch_inventory", "displayName": "_rgch_inventory", "minEntries": 1, "maxEntries": 1, "type": "table", "id": "_rgch_inventory", "label": "_rgch_inventory"}], "outputPorts": [{"name": "_rgch_invout", "displayName": "_rgch_invout", "minEntries": 1, "maxEntries": 1, "columnDelta": null, "type": "table"}]}, "metadataVersion": 1, "name": "RAG - Chunk Documents.step", "properties": {}, "templates": {"SAS": "/******************************************************************************\n * Copyright \u00a9 2026, SAS Institute Inc., Cary, NC, USA.  All Rights Reserved.\n * SPDX-License-Identifier: Apache-2.0\n *\n * RAG - Chunk Documents: token-aware chunking of the extracted elements\n * (<project>_ELEMENTS) into the promoted CAS table <project>_CHUNKS. The\n * chunk size is budgeted INSIDE the embedding model's token window (overlap\n * included) so no chunk is ever silently truncated by the model.\n * Thin shell over rag_core.steps.run_chunk - see the About tab.\n ******************************************************************************/\n%macro _rgch_setup;\n    %if not %symexist(_rgch_ragProject) %then %global _rgch_ragProject;\n    %if not %symexist(_rgch_tablesCaslib) %then %global _rgch_tablesCaslib;\n    %if not %symexist(_rgch_persist) %then %global _rgch_persist;\n    %if %length(%superq(_rgch_persist)) EQ 0 %then %let _rgch_persist = 1;\n%mend _rgch_setup;\n%_rgch_setup;\n/* Pipeline-wide state, shared by every RAG step in this session.\n   RAG_ABORT_ON_ERROR: 1 (default) stops a SAS Studio Flow at the failing\n   step, which is what an interactive user wants. A SCHEDULED run sets it to\n   0: an aborted session never sends SAS Job Execution its completion\n   handshake, so the job would report running forever and its dead compute\n   server would keep counting against the context's server limit.\n   RAG_PIPELINE_FAILED: set by the step that fails; later steps then skip\n   their work and pass the inventory through, so the flow finishes tidily\n   instead of loading half a corpus. */\n%macro _rag_pipeline_state;\n    %if not %symexist(RAG_ABORT_ON_ERROR) %then %do;\n        %global RAG_ABORT_ON_ERROR;\n        %let RAG_ABORT_ON_ERROR = 1;\n    %end;\n    %if %length(%superq(RAG_ABORT_ON_ERROR)) EQ 0 %then\n        %let RAG_ABORT_ON_ERROR = 1;\n    %if not %symexist(RAG_PIPELINE_FAILED) %then %global RAG_PIPELINE_FAILED;\n    %if %length(%superq(RAG_PIPELINE_FAILED)) EQ 0 %then\n        %let RAG_PIPELINE_FAILED = 0;\n%mend _rag_pipeline_state;\n%_rag_pipeline_state;\n\n%let _rgch_viyaHost = %sysfunc(getoption(SERVICESBASEURL));\n%let _rgch_rc = 1;\n%let _rgch_state = run;\n%let _rgch_error = The Python program did not run.;\n%let _rgch_summary = ;\n%let _rgch_nch = 0;\n%let _rgch_ninv = 0;\n\n%macro _rgch_guard;\n    %if &RAG_PIPELINE_FAILED. NE 0 %then %do;\n        %let _rgch_state = skip;\n        data _null_;\n            putLog \"NOTE: RAG - Chunk Documents: skipped - an earlier step of this run failed\";\n        run;\n    %end;\n%mend _rgch_guard;\n%_rgch_guard;\n%macro _rgch_inherit;\n    %global _rgch_runId;\n    %local dsid vproject vcaslib vrun rc;\n    %if %symexist(_rgch_inventory) %then\n    %if %length(%superq(_rgch_inventory)) NE 0 %then %do;\n        %if %sysfunc(exist(&_rgch_inventory.)) %then %do;\n            %let dsid = %sysfunc(open(&_rgch_inventory., i));\n            %if &dsid. NE 0 %then %do;\n                %let vproject = %sysfunc(varnum(&dsid., rag_project));\n                %let vcaslib = %sysfunc(varnum(&dsid., tables_caslib));\n                %let vrun = %sysfunc(varnum(&dsid., run_id));\n                %if %sysfunc(fetch(&dsid.)) EQ 0 %then %do;\n                    %if &vproject. GT 0 %then\n                        %let _rgch_ragProject = %sysfunc(getvarc(&dsid., &vproject.));\n                    %if &vcaslib. GT 0 %then\n                        %let _rgch_tablesCaslib = %sysfunc(getvarc(&dsid., &vcaslib.));\n                    /* the run id too: the lock belongs to the RUN, so a step\n                       that fails has to know which lock row to hand back */\n                    %if &vrun. GT 0 %then\n                        %let _rgch_runId = %sysfunc(getvarc(&dsid., &vrun.));\n                %end;\n                %let rc = %sysfunc(close(&dsid.));\n            %end;\n        %end;\n    %end;\n    /* a missing project is a failure of THIS step - but not when the step is\n       already skipping, where an absent inventory is expected */\n    %if &_rgch_state. EQ run %then\n    %if %length(%superq(_rgch_ragProject)) EQ 0 %then %do;\n        %let _rgch_state = fail;\n        /* one line: the value is embedded in a quoted putLog below, so a\n           newline inside it would break the string */\n        %let _rgch_error = the inventory does not name a RAG project - wire the output of RAG - List Documents into this step;\n    %end;\n    %if %length(%superq(_rgch_tablesCaslib)) EQ 0 %then\n        %let _rgch_tablesCaslib = casuser;\n%mend _rgch_inherit;\n%_rgch_inherit;\n%macro _rgch_port_default;\n    %if not %symexist(_rgch_invout) %then %global _rgch_invout;\n    %if %length(%superq(_rgch_invout)) EQ 0 %then\n        %let _rgch_invout = rgchout.&_rgch_ragProject._INV_CHUNK;\n%mend _rgch_port_default;\n%_rgch_port_default;\n/* One CAS session for the whole step: created here, reused by\n   SWAT inside proc python, promote+save done by proc casutil.\n   rgchout is where the step's OUTPUT TABLE lands by default -\n   the same caslib as the pipeline tables, so a flow leaves its\n   intermediate results next to each other. */\ncas rgchcas uuidmac=_rgch_casuuid;\n%let _rgch_cashost = %sysfunc(getoption(CASHOST));\n%let _rgch_casport = %sysfunc(getoption(CASPORT));\nlibname rgchout cas caslib=\"&_rgch_tablesCaslib.\" sessref=rgchcas;\n\n%macro _rgch_export(portvar, file);\n    %if %symexist(&portvar.) %then %do;\n        %if %length(%superq(&&portvar.)) GT 0 %then %do;\n            %if %sysfunc(exist(&&&portvar..)) %then %do;\n                filename _rgch_io \"%sysfunc(pathname(work))/&file.\";\n                proc json out=_rgch_io noSASTags;\n                    export &&&portvar..;\n                run; quit;\n                filename _rgch_io clear;\n            %end;\n        %end;\n    %end;\n%mend _rgch_export;\n%_rgch_export(_rgch_inventory, rgch_inventory_in.json);\n\nproc python restart;\nsubmit;\ndef main():\n    import json\n    import os\n    import sys\n    import tempfile\n    import time\n    import traceback\n\n    # nothing to do when the step is only passing the inventory through\n    if str(SAS.symget(\"_rgch_state\") or \"run\").strip() != \"run\":\n        return\n\n    def sas_safe(text):\n        \"\"\"Strings crossing into SAS.logMessage/SAS.symput are embedded into\n        generated SAS statements - quotes and macro characters corrupt the\n        code stream (verified live). EVERY such string goes through here.\"\"\"\n        cleaned = str(text)\n        for ch in (\"'\", '\"', \"%\", \"&\", \";\"):\n            cleaned = cleaned.replace(ch, \" \")\n        return cleaned\n\n    def M(msg):\n        SAS.logMessage(\"RAGCHUNK \" + sas_safe(msg))\n\n    try:\n        import requests\n    except Exception:\n        SAS.symput(\"_rgch_error\", \"The Python environment of this compute \"\n                                   \"context lacks the requests package - see \"\n                                   \"the RAG administration guide.\")\n        return\n    try:\n        import pandas as pd\n        import swat\n    except Exception:\n        SAS.symput(\"_rgch_error\", \"The Python environment of this compute \"\n                                   \"context lacks the swat/pandas packages \"\n                                   \"required for the CAS table transport - \"\n                                   \"see the RAG administration guide.\")\n        return\n\n    BASE = str(SAS.symget(\"_rgch_viyaHost\") or \"\").rstrip(\"/\")\n    TOKEN = os.environ.get(\"SAS_SERVICES_TOKEN\", \"\")\n    AUTH = {\"Authorization\": \"Bearer \" + TOKEN}\n    VERIFY = os.environ.get(\"SSLCALISTLOC\") or os.environ.get(\"CAS_CLIENT_SSL_CA_LIST\") or True\n    WORKPATH = SAS.workpath if SAS.workpath.endswith(os.sep) else SAS.workpath + os.sep\n\n    P = {name: str(SAS.symget(name) or \"\").strip() for name in [\n        \"_rgch_chunker\",\n        \"_rgch_inputTokenLimit\",\n        \"_rgch_overlapTokens\",\n        \"_rgch_ragProject\",\n        \"_rgch_tablesCaslib\",\n        \"_rgch_ragCorePath\",\n    ]}\n\n    def read_rows(filename, missing_message):\n        path = WORKPATH + filename\n        if not os.path.exists(path):\n            raise RuntimeError(missing_message)\n        with open(path, \"r\", encoding=\"utf-8\") as fh:\n            data = json.load(fh)\n        rows = []\n        for row in data if isinstance(data, list) else []:\n            rows.append({str(k).lower(): v for k, v in row.items()})\n        return rows\n\n    def multiline(control):\n        \"\"\"Every line a user typed into a multi-line text field.\n\n        SAS Studio splits such a field for us: it emits <control>_count and\n        <control>_1..N, and leaves the plain macro variable holding only the\n        FIRST line. Reading just the plain one silently turned two questions\n        into one run-on question (found live in a flow). Semicolons are still\n        accepted, for callers that set the parameter directly.\n        \"\"\"\n        values = []\n        try:\n            count = int(float(SAS.symget(control + \"_count\") or 0))\n        except Exception:\n            count = 0\n        if count > 0:\n            for index in range(1, count + 1):\n                try:\n                    piece = str(SAS.symget(\"%s_%d\" % (control, index)) or \"\")\n                except Exception:\n                    piece = \"\"\n                if piece.strip():\n                    values.append(piece.strip())\n            if values:\n                return values\n        raw = str(P.get(control) or \"\").replace(\";\", \"\\n\")\n        return [line.strip() for line in raw.split(\"\\n\") if line.strip()]\n\n    def clean_path(raw):\n        \"\"\"Path-selector values arrive scheme-prefixed (sasserver:/...,\n        sascontent:/...); strip the scheme off.\"\"\"\n        value = str(raw or \"\").strip()\n        for scheme in (\"sascontent:\", \"sasserver:\"):\n            if value.lower().startswith(scheme):\n                return value[len(scheme):]\n        return value\n\n    STARTED = time.time()\n    SUMMARY = []\n\n    def summarize(line):\n        \"\"\"One line of the step's log summary (SAS prints them at the end).\"\"\"\n        SUMMARY.append(str(line))\n\n    def publish_summary(target):\n        elapsed = time.time() - STARTED\n        summarize(f\"elapsed {elapsed:.1f}s\")\n        SAS.symput(target, sas_safe(\" | \".join(SUMMARY))[:1500])\n\n    def write_rows(filename, rows, columns, numeric=()):\n        out = []\n        for row in rows:\n            rec = {}\n            for column in columns:\n                value = row.get(column)\n                if column in numeric:\n                    try:\n                        rec[column] = float(value or 0)\n                    except Exception:\n                        rec[column] = 0.0\n                else:\n                    rec[column] = \"\" if value is None else str(value)\n            out.append(rec)\n        with open(WORKPATH + filename, \"w\", encoding=\"utf-8\") as fh:\n            json.dump(out, fh)\n        return len(out)\n\n    try:\n        # ---- CAS: reuse the session the step created in SAS ---------------\n        # (sas-studio-custom-steps: Reuse-CAS-session-from-SWAT)\n        import re as _re\n        os.environ.setdefault(\"CAS_CLIENT_SSL_CA_LIST\",\n                              os.environ.get(\"SSLCALISTLOC\", \"\"))\n        try:\n            conn = swat.CAS(hostname=str(SAS.symget(\"_rgch_cashost\") or \"\"),\n                            port=int(float(SAS.symget(\"_rgch_casport\") or 5570)),\n                            password=TOKEN,\n                            session=str(SAS.symget(\"_rgch_casuuid\") or \"\"))\n        except Exception as exc:\n            # The step reuses the CAS session SAS created, because the staged\n            # table has to be visible to the casutil promote that follows. CAS\n            # only lets an identity reconnect to its OWN session, and a context\n            # that runs the server as a service account breaks that: SAS and\n            # its token are the service account while the CAS session belongs\n            # to the user who launched the job.\n            #\n            # SWAT's exception says only \"Could not connect ... on port 5570\";\n            # the server's real message (\"Users can only reconnect to their own\n            # sessions\") goes to stderr and never reaches the exception, so\n            # matching on text does not work. Connecting WITHOUT the session id\n            # separates the two causes: if that works, CAS is reachable and the\n            # problem is whose session it is.\n            reachable = False\n            try:\n                probe = swat.CAS(\n                    hostname=str(SAS.symget(\"_rgch_cashost\") or \"\"),\n                    port=int(float(SAS.symget(\"_rgch_casport\") or 5570)),\n                    password=TOKEN)\n                reachable = True\n                probe.close()\n            except Exception:\n                pass\n            if reachable:\n                raise RuntimeError(\n                    \"this compute context cannot run the RAG steps: CAS is \"\n                    \"reachable, but the SAS session and the CAS session belong \"\n                    \"to different identities, so the step cannot reuse the CAS \"\n                    \"session it needs. The stock 'SAS Job Execution compute \"\n                    \"context' has this problem because it runs the server as a \"\n                    \"service account. Run the job in a context that runs as the \"\n                    \"REQUESTING USER - the 'SAS Studio compute context' does, \"\n                    \"and a full flow was verified there. See the RAG \"\n                    \"administration guide.\")\n            raise\n        CASLIB = P[\"_rgch_tablesCaslib\"] or \"casuser\"\n        if not _re.match(r\"^[A-Za-z][A-Za-z0-9_]{0,19}$\",\n                         P[\"_rgch_ragProject\"] or \"\"):\n            raise RuntimeError(\n                \"ragProject must be 1-20 characters (letters, digits, \"\n                \"underscores, starting with a letter) so every \"\n                \"project_suffix table name stays within the 32 characters \"\n                \"SAS Studio displays\")\n\n        def project_table(suffix):\n            return P[\"_rgch_ragProject\"] + suffix\n\n        def stamp(rows):\n            \"\"\"Every inventory row names its pipeline, so the next step\n            inherits the project and caslib instead of asking again.\"\"\"\n            for row in rows:\n                row[\"rag_project\"] = P[\"_rgch_ragProject\"]\n                row[\"tables_caslib\"] = CASLIB\n            return rows\n\n        def cas_read(name, required_message=None):\n            \"\"\"Read a pipeline table into lower-cased row dicts; absent\n            table = empty (the pipeline's empty state) unless required.\"\"\"\n            if not conn.table.tableExists(caslib=CASLIB, name=name).exists:\n                if required_message:\n                    raise RuntimeError(required_message)\n                return []\n            frame = conn.CASTable(name, caslib=CASLIB).to_frame()\n            rows = []\n            for record in frame.to_dict(\"records\"):\n                row = {}\n                for key, value in record.items():\n                    row[str(key).lower()] = None if pd.isna(value) else value\n                rows.append(row)\n            return rows\n\n        def label_columns(name, columns):\n            \"\"\"Put the shipped column labels on a CAS table - they survive\n            the promote, so the pipeline tables read without the schema.\"\"\"\n            try:\n                from rag_core.steps import column_labels\n                labels = column_labels(columns)\n                if labels:\n                    conn.table.alterTable(\n                        caslib=CASLIB, name=name,\n                        columns=[{\"name\": column, \"label\": label}\n                                 for column, label in labels.items()])\n            except Exception as exc:\n                M(f\"column labels not applied to {name}: {exc}\")\n\n        def cas_stage(name, rows, columns, numeric=()):\n            \"\"\"Upload the session-scope staging table <name>_S with varchar\n            columns (no 32k limit); the SAS side swaps it into the promoted\n            global table and saves it, so the previous state survives a\n            mid-step failure.\"\"\"\n            if not rows:\n                return 0\n            data = []\n            for row in rows:\n                rec = []\n                for column in columns:\n                    value = row.get(column)\n                    if column in numeric:\n                        try:\n                            rec.append(float(value or 0))\n                        except Exception:\n                            rec.append(0.0)\n                    else:\n                        rec.append(\"\" if value is None else str(value))\n                data.append(rec)\n            frame = pd.DataFrame(data, columns=list(columns))\n            spec = [{\"name\": column,\n                     \"type\": \"double\" if column in numeric else \"varchar\"}\n                    for column in columns]\n            conn.upload_frame(frame,\n                              casout={\"name\": name + \"_S\", \"caslib\": CASLIB,\n                                      \"replace\": True},\n                              importoptions={\"fileType\": \"csv\",\n                                             \"allowEmbeddedNewLines\": True,\n                                             \"vars\": spec})\n            label_columns(name + \"_S\", columns)\n            return len(rows)\n\n        # ---- rag_core bootstrap: download the governed SAS Content folder --\n        def get_json(endpoint, **params):\n            response = requests.get(BASE + endpoint, params=params, headers=AUTH,\n                                    verify=VERIFY, timeout=(5, 30))\n            response.raise_for_status()\n            return response.json()\n\n        def download_folder(folder_id, local_dir):\n            os.makedirs(local_dir, exist_ok=True)\n            count = 0\n            members = get_json(f\"/folders/folders/{folder_id}/members\", limit=200)\n            for member in members.get(\"items\", []):\n                uri = member.get(\"uri\", \"\")\n                if \"/files/files/\" in uri:\n                    content = requests.get(BASE + uri + \"/content\", headers=AUTH,\n                                           verify=VERIFY, timeout=(5, 60))\n                    content.raise_for_status()\n                    with open(os.path.join(local_dir, member[\"name\"]), \"wb\") as fh:\n                        fh.write(content.content)\n                    count += 1\n                elif \"/folders/folders/\" in uri:\n                    count += download_folder(uri.rsplit(\"/\", 1)[-1],\n                                             os.path.join(local_dir, member[\"name\"]))\n            return count\n\n        core_path = (clean_path(P[\"_rgch_ragCorePath\"])\n                     or \"/SAS Agentic AI Accelerator/RAG/rag_core\")\n        root = requests.get(BASE + \"/folders/folders/@item\",\n                            params={\"path\": core_path}, headers=AUTH,\n                            verify=VERIFY, timeout=(5, 30))\n        if root.status_code != 200:\n            raise RuntimeError(f\"rag_core folder {core_path} not found \"\n                               f\"(HTTP {root.status_code}) - deploy it per the \"\n                               \"administration guide\")\n        staging = tempfile.mkdtemp(prefix=\"rag_core_\")\n        n_files = download_folder(root.json()[\"id\"], os.path.join(staging, \"rag_core\"))\n        sys.path.insert(0, staging)\n        import rag_core\n        M(f\"rag_core {rag_core.RAG_CORE_VERSION} bootstrapped ({n_files} files)\")\n\n        def chunk_to_row(chunk):\n            row = dict(chunk)\n            for column in (\"span\", \"tags\", \"attributes\", \"entities\",\n                           \"relations\", \"embedding\"):\n                value = chunk.get(column)\n                row[column] = json.dumps(value) if value not in (None, \"\", {}) else \"\"\n            return row\n\n        def row_to_chunk(row):\n            chunk = dict(row)\n            chunk[\"chunk_index\"] = int(float(row.get(\"chunk_index\") or 0))\n            for column in (\"span\", \"entities\", \"relations\", \"embedding\"):\n                chunk[column] = json.loads(row[column]) if row.get(column) else None\n            chunk[\"attributes\"] = (json.loads(row[\"attributes\"])\n                                   if row.get(\"attributes\") else {})\n            chunk[\"tags\"] = json.loads(row[\"tags\"]) if row.get(\"tags\") else {}\n            for column in (\"heading_path\", \"prev_id\", \"next_id\", \"context_header\"):\n                chunk[column] = row.get(column) or None\n            return chunk\n\n        from rag_core.steps import (CHUNK_COLUMNS, INVENTORY_COLUMNS, run_chunk,\n                                    stamp_config)\n\n        inventory_columns = INVENTORY_COLUMNS\n        inventory = read_rows(\"rgch_inventory_in.json\",\n                              \"the inventory input port is not connected - \"\n                              \"wire the RAG - Extract Text updated-inventory \"\n                              \"output into this step\")\n        elements = cas_read(project_table(\"_ELEMENTS\"))\n        pipeline_version = \"v1\"\n        for row in inventory:\n            if row.get(\"pipeline_version\"):\n                pipeline_version = row[\"pipeline_version\"]\n                break\n\n        chunker = P[\"_rgch_chunker\"] or \"recursive\"\n        token_limit = int(float(P[\"_rgch_inputTokenLimit\"] or 256))\n        overlap = int(float(P[\"_rgch_overlapTokens\"] or 30))\n        chunks = run_chunk(elements, inventory, chunker, token_limit,\n                           pipeline_version, overlap_tokens=overlap, log=M)\n        n_chunks = cas_stage(project_table(\"_CHUNKS\"),\n                             [chunk_to_row(c) for c in chunks],\n                             CHUNK_COLUMNS, numeric=(\"chunk_index\",))\n        stamp_config(inventory, {\"chunker\": chunker,\n                                 \"input_token_limit\": token_limit,\n                                 \"overlap_tokens\": overlap if chunker == \"recursive\" else None})\n        n_inventory = write_rows(\"rgch_inventory_out.json\", stamp(inventory),\n                                 inventory_columns, numeric=(\"chunk_count\",))\n        SAS.symput(\"_rgch_nch\", str(n_chunks))\n        SAS.symput(\"_rgch_ninv\", str(n_inventory))\n        n_docs = len({c[\"doc_id\"] for c in chunks})\n        sizes = sorted(len(c[\"content\"]) for c in chunks)\n        summarize(f\"chunker: {chunker}\"\n                  + (f\", overlap {overlap} tokens\" if chunker == \"recursive\" else \"\"))\n        summarize(f\"token window: {token_limit} (chunk budget applies a \"\n                  \"safety margin inside it)\")\n        summarize(f\"{len(elements)} elements read from \"\n                  f\"{CASLIB}.{project_table('_ELEMENTS')}\")\n        summarize(f\"{n_chunks} chunks from {n_docs} documents written to \"\n                  f\"{CASLIB}.{project_table('_CHUNKS')}\")\n        if sizes:\n            summarize(f\"chunk size in characters: min {sizes[0]}, median \"\n                      f\"{sizes[len(sizes) // 2]}, max {sizes[-1]}\")\n        publish_summary(\"_rgch_summary\")\n\n        try:\n            conn.close(close_session=False)\n        except Exception:\n            pass\n        SAS.symput(\"_rgch_rc\", \"0\")\n    except Exception as error:\n        error_text = f\"{type(error).__name__}: {error}\"\n        M(\"failed: \" + sas_safe(error_text))\n        print(traceback.format_exc())\n        SAS.symput(\"_rgch_error\", sas_safe(error_text)[:500])\n\n\nmain()\nendsubmit;\nrun; quit;\nproc python terminate;\nrun; quit;\n\n%macro _rgch_swap(suffix, count, persist=1);\n    %if &_rgch_rc. NE 0 %then %return;\n    %if &count. LT 0 %then %return;\n    proc casutil sessref=rgchcas incaslib=\"&_rgch_tablesCaslib.\"\n                 outcaslib=\"&_rgch_tablesCaslib.\";\n        droptable casdata=\"&_rgch_ragProject.&suffix.\" quiet;\n        %if &count. GT 0 %then %do;\n            promote casdata=\"&_rgch_ragProject.&suffix._S\"\n                    casout=\"&_rgch_ragProject.&suffix.\";\n            %if &persist. EQ 1 %then %do;\n                save casdata=\"&_rgch_ragProject.&suffix.\"\n                     casout=\"&_rgch_ragProject.&suffix.\" replace;\n            %end;\n            %else %do;\n                /* not persisted by choice: clear any file an earlier run\n                   saved, or a restart would resurrect stale content */\n                deletesource casdata=\"&_rgch_ragProject.&suffix..sashdat\" quiet;\n            %end;\n        %end;\n        %else %do;\n            deletesource casdata=\"&_rgch_ragProject.&suffix..sashdat\" quiet;\n        %end;\n    quit;\n%mend _rgch_swap;\n%_rgch_swap(_CHUNKS, &_rgch_nch., persist=&_rgch_persist.);\n%macro _rgch_passthrough;\n    %if &_rgch_state. NE skip %then %return;\n    %local lib table opts;\n    %let lib = %upcase(%scan(&_rgch_invout., 1, .));\n    %let table = %scan(&_rgch_invout., 2, .);\n    %if &lib. EQ %upcase(rgchout) %then %do;\n        proc casutil sessref=rgchcas\n                     incaslib=\"&_rgch_tablesCaslib.\"\n                     outcaslib=\"&_rgch_tablesCaslib.\";\n            droptable casdata=\"&table.\" quiet;\n        quit;\n        %let opts = (promote=yes);\n    %end;\n    %else %let opts = (compress=yes);\n    %if %symexist(_rgch_inventory) %then\n    %if %length(%superq(_rgch_inventory)) NE 0 %then\n    %if %sysfunc(exist(&_rgch_inventory.)) %then %do;\n        data &_rgch_invout.&opts.;\n            set &_rgch_inventory.;\n        run;\n    %end;\n%mend _rgch_passthrough;\n%_rgch_passthrough;\n\n%macro _rgch_emit_inventory;\n    %if &_rgch_rc. NE 0 %then %return;\n    %local lib table opts;\n    %let lib = %upcase(%scan(&_rgch_invout., 1, .));\n    %let table = %scan(&_rgch_invout., 2, .);\n    %if &lib. EQ %upcase(rgchout) %then %do;\n        proc casutil sessref=rgchcas\n                     incaslib=\"&_rgch_tablesCaslib.\"\n                     outcaslib=\"&_rgch_tablesCaslib.\";\n            droptable casdata=\"&table.\" quiet;\n        quit;\n        %let opts = (promote=yes);\n    %end;\n    %else %let opts = (compress=yes);\n    %if &_rgch_ninv. GT 0 %then %do;\n        filename rgchino \"%sysfunc(pathname(work))/rgch_inventory_out.json\";\n        libname rgchinj json fileref=rgchino;\n        data &_rgch_invout.&opts.;\n            length doc_id $ 40 source_uri $ 1024 source_kind $ 16\n                   content_hash $ 64 mtime $ 32 status $ 12 error_text $ 512\n                   pipeline_version $ 32 config_hash $ 32 chunk_count 8\n                   run_id $ 32 updated_at $ 24 extractor $ 64\n                   rag_project $ 20 tables_caslib $ 32 config_json $ 1024\n                   embed_usage $ 256 enrich_usage $ 256;\n            label doc_id=\"Document ID\" source_uri=\"Source location\"\n                  source_kind=\"Source type\" content_hash=\"Content fingerprint\"\n                  mtime=\"Source last modified\" status=\"Ingestion status\"\n                  error_text=\"Failure reason\" pipeline_version=\"Pipeline version\"\n                  config_hash=\"Configuration fingerprint\" chunk_count=\"Chunks produced\"\n                  run_id=\"Ingestion run ID\" updated_at=\"Row updated (UTC)\"\n                  extractor=\"Text extractor used\" rag_project=\"RAG project\"\n                  tables_caslib=\"Pipeline tables caslib\"\n                  config_json=\"Pipeline configuration (JSON)\"\n                  embed_usage=\"Embedding usage (JSON)\"\n                  enrich_usage=\"Enrichment usage (JSON)\";\n            set rgchinj.root(drop=ordinal_root);\n        run;\n        libname rgchinj clear;\n        filename rgchino clear;\n    %end;\n    %else %do;\n        data &_rgch_invout.&opts.;\n            length doc_id $ 40 source_uri $ 1024 source_kind $ 16\n                   content_hash $ 64 mtime $ 32 status $ 12 error_text $ 512\n                   pipeline_version $ 32 config_hash $ 32 chunk_count 8\n                   run_id $ 32 updated_at $ 24 extractor $ 64\n                   rag_project $ 20 tables_caslib $ 32 config_json $ 1024\n                   embed_usage $ 256 enrich_usage $ 256;\n            label doc_id=\"Document ID\" source_uri=\"Source location\"\n                  source_kind=\"Source type\" content_hash=\"Content fingerprint\"\n                  mtime=\"Source last modified\" status=\"Ingestion status\"\n                  error_text=\"Failure reason\" pipeline_version=\"Pipeline version\"\n                  config_hash=\"Configuration fingerprint\" chunk_count=\"Chunks produced\"\n                  run_id=\"Ingestion run ID\" updated_at=\"Row updated (UTC)\"\n                  extractor=\"Text extractor used\" rag_project=\"RAG project\"\n                  tables_caslib=\"Pipeline tables caslib\"\n                  config_json=\"Pipeline configuration (JSON)\"\n                  embed_usage=\"Embedding usage (JSON)\"\n                  enrich_usage=\"Enrichment usage (JSON)\";\n            call missing(of _all_);\n            stop;\n        run;\n    %end;\n%mend _rgch_emit_inventory;\n%_rgch_emit_inventory;\n%macro _rgch_release;\n    %local failing;\n    %let failing = 0;\n    %if &_rgch_state. EQ fail %then %let failing = 1;\n    %if &_rgch_state. EQ run %then %if &_rgch_rc. NE 0 %then %let failing = 1;\n    %if &failing. EQ 0 %then %return;\n    %if not %symexist(_rgch_runId) %then %return;\n    %if %length(%superq(_rgch_runId)) EQ 0 %then %return;\n    %if not %sysfunc(exist(rgchout.&_rgch_ragProject._LEDGER)) %then %return;\n    data rgchout.&_rgch_ragProject._LEDGER_R(replace=yes);\n        set rgchout.&_rgch_ragProject._LEDGER(where=(not (doc_id = \"__run_lock__\"\n                                 and run_id = \"&_rgch_runId.\")));\n    run;\n    proc casutil sessref=rgchcas incaslib=\"&_rgch_tablesCaslib.\"\n                 outcaslib=\"&_rgch_tablesCaslib.\";\n        droptable casdata=\"&_rgch_ragProject._LEDGER\" quiet;\n        promote casdata=\"&_rgch_ragProject._LEDGER_R\"\n                casout=\"&_rgch_ragProject._LEDGER\";\n        save casdata=\"&_rgch_ragProject._LEDGER\"\n             casout=\"&_rgch_ragProject._LEDGER\" replace;\n    quit;\n    data _null_;\n        putLog \"NOTE: RAG - Chunk Documents: the run lock was released so the run can be retried\";\n    run;\n%mend _rgch_release;\n%_rgch_release;\n\nlibname rgchout clear;\ncas rgchcas terminate;\n\n%macro _rgch_status;\n    %if &_rgch_state. EQ run %then %if &_rgch_rc. NE 0 %then\n        %let _rgch_state = fail;\n    %if &_rgch_state. EQ skip %then %do;\n        data _null_;\n            putLog \"NOTE: ----- RAG - Chunk Documents: skipped -----\";\n        run;\n        %return;\n    %end;\n    %if &_rgch_state. EQ fail %then %do;\n        %let RAG_PIPELINE_FAILED = 1;\n        data _null_;\n            putLog \"ERROR: RAG - Chunk Documents failed: %superq(_rgch_error)\";\n        run;\n        %if &RAG_ABORT_ON_ERROR. NE 0 %then %do;\n            data _null_;\n                abort 42;\n            run;\n        %end;\n        %return;\n    %end;\n    data _null_;\n        length part $ 500;\n        putLog \"NOTE: ----- RAG - Chunk Documents -----\";\n        do i = 1 to countw(\"%superq(_rgch_summary)\", \"|\");\n            part = strip(scan(\"%superq(_rgch_summary)\", i, \"|\"));\n            if part ne \"\" then putLog \"NOTE:   \" part;\n        end;\n    run;\n%mend _rgch_status;\n%_rgch_status;"}, "type": "code", "ui": "{\n\t\"showPageContentOnly\": true,\n\t\"pages\": [\n\t\t{\n\t\t\t\"id\": \"pageDefinition\",\n\t\t\t\"type\": \"page\",\n\t\t\t\"label\": \"Definition\",\n\t\t\t\"children\": [\n\t\t\t\t{\n\t\t\t\t\t\"id\": \"_rgch_info\",\n\t\t\t\t\t\"type\": \"text\",\n\t\t\t\t\t\"text\": \"Splits the extracted elements (<project>_ELEMENTS) into embedding-ready chunks in <project>_CHUNKS. Sizes are counted in tokens and budgeted inside the embedding model's input window - set the token limit to your embedding model's Input_Token_Limit (256 for all_minilm_l6_v2).\",\n\t\t\t\t\t\"visible\": \"\"\n\t\t\t\t},\n\t\t\t\t{\n\t\t\t\t\t\"id\": \"_rgch_inventory\",\n\t\t\t\t\t\"type\": \"inputtable\",\n\t\t\t\t\t\"label\": \"Updated inventory (from RAG - Extract Text):\",\n\t\t\t\t\t\"required\": false,\n\t\t\t\t\t\"placeholder\": \"\",\n\t\t\t\t\t\"visible\": \"\"\n\t\t\t\t},\n\t\t\t\t{\n\t\t\t\t\t\"id\": \"_rgch_chunker\",\n\t\t\t\t\t\"type\": \"radiogroup\",\n\t\t\t\t\t\"label\": \"Chunker:\",\n\t\t\t\t\t\"items\": [\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"value\": \"recursive\",\n\t\t\t\t\t\t\t\"label\": \"Recursive (boundary-aware, with overlap)\"\n\t\t\t\t\t\t},\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"value\": \"paragraph\",\n\t\t\t\t\t\t\t\"label\": \"Paragraph\"\n\t\t\t\t\t\t}\n\t\t\t\t\t],\n\t\t\t\t\t\"visible\": \"\"\n\t\t\t\t},\n\t\t\t\t{\n\t\t\t\t\t\"id\": \"_rgch_inputTokenLimit\",\n\t\t\t\t\t\"type\": \"numstepper\",\n\t\t\t\t\t\"label\": \"Embedding model token window (Input_Token_Limit):\",\n\t\t\t\t\t\"integer\": true,\n\t\t\t\t\t\"min\": 16,\n\t\t\t\t\t\"max\": null,\n\t\t\t\t\t\"stepsize\": 1,\n\t\t\t\t\t\"required\": false,\n\t\t\t\t\t\"visible\": \"\"\n\t\t\t\t},\n\t\t\t\t{\n\t\t\t\t\t\"id\": \"_rgch_overlapTokens\",\n\t\t\t\t\t\"type\": \"numstepper\",\n\t\t\t\t\t\"label\": \"Chunk overlap in tokens:\",\n\t\t\t\t\t\"integer\": true,\n\t\t\t\t\t\"min\": 0,\n\t\t\t\t\t\"max\": null,\n\t\t\t\t\t\"stepsize\": 1,\n\t\t\t\t\t\"required\": false,\n\t\t\t\t\t\"visible\": [\n\t\t\t\t\t\t\"$_rgch_chunker\",\n\t\t\t\t\t\t\"=\",\n\t\t\t\t\t\t\"recursive\"\n\t\t\t\t\t]\n\t\t\t\t},\n\t\t\t\t{\n\t\t\t\t\t\"id\": \"_rgch_sectionAdvanced\",\n\t\t\t\t\t\"type\": \"section\",\n\t\t\t\t\t\"label\": \"Runtime\",\n\t\t\t\t\t\"open\": false,\n\t\t\t\t\t\"visible\": \"\",\n\t\t\t\t\t\"children\": [\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"id\": \"_rgch_persist\",\n\t\t\t\t\t\t\t\"type\": \"dropdown\",\n\t\t\t\t\t\t\t\"label\": \"Chunk table (<project>_CHUNKS):\",\n\t\t\t\t\t\t\t\"items\": [\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\"value\": \"1\",\n\t\t\t\t\t\t\t\t\t\"label\": \"Save to disk (survives a server restart)\"\n\t\t\t\t\t\t\t\t},\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\"value\": \"0\",\n\t\t\t\t\t\t\t\t\t\"label\": \"Keep in memory only (rebuilt on the next run)\"\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t],\n\t\t\t\t\t\t\t\"required\": false,\n\t\t\t\t\t\t\t\"visible\": \"\"\n\t\t\t\t\t\t},\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"id\": \"_rgch_ragCorePath\",\n\t\t\t\t\t\t\t\"type\": \"path\",\n\t\t\t\t\t\t\t\"label\": \"SAS Content folder holding rag_core (set by the deployment - not editable here):\",\n\t\t\t\t\t\t\t\"pathtype\": \"folder\",\n\t\t\t\t\t\t\t\"placeholder\": \"\",\n\t\t\t\t\t\t\t\"required\": false,\n\t\t\t\t\t\t\t\"visible\": \"\",\n\t\t\t\t\t\t\t\"enabled\": [\n\t\t\t\t\t\t\t\t\"$_rgch_ragCorePath\",\n\t\t\t\t\t\t\t\t\"=\",\n\t\t\t\t\t\t\t\t\"__set_by_deployment__\"\n\t\t\t\t\t\t\t]\n\t\t\t\t\t\t}\n\t\t\t\t\t]\n\t\t\t\t},\n\t\t\t\t{\n\t\t\t\t\t\"id\": \"_rgch_invout\",\n\t\t\t\t\t\"type\": \"outputtable\",\n\t\t\t\t\t\"label\": \"Updated inventory output (wire this one forward):\",\n\t\t\t\t\t\"required\": false,\n\t\t\t\t\t\"placeholder\": \"\",\n\t\t\t\t\t\"visible\": \"\"\n\t\t\t\t}\n\t\t\t]\n\t\t},\n\t\t{\n\t\t\t\"id\": \"pageAbout\",\n\t\t\t\"type\": \"page\",\n\t\t\t\"label\": \"About\",\n\t\t\t\"children\": [\n\t\t\t\t{\n\t\t\t\t\t\"id\": \"textAbout\",\n\t\t\t\t\t\"type\": \"text\",\n\t\t\t\t\t\"text\": \"RAG - Chunk Documents step\\n==========\\n\\nPure-python token-aware chunkers (no LangChain). Chunk ids are deterministic - sha1(doc_id + index + content_hash) - so re-ingesting an unchanged document is idempotent, and the Embed step reuses vectors by chunk id. The updated inventory carries each document's chunk count forward to the ledger.\\n\\nFlow wiring: chain the document INVENTORY through every step - RAG - List Documents \u2192 Extract Text \u2192 Chunk Documents \u2192 Embed Chunks \u2192 Load Vector Store. The bulk data travels beside the flow in promoted CAS tables named <project>_ELEMENTS, <project>_CHUNKS, <project>_EMBEDDED and <project>_LEDGER in the tables caslib (each saved to disk, so state survives server restarts; names stay within 32 characters so they display nicely in SAS Studio). Each step's output table lands in that same caslib as <project>_INV_LIST, _INV_EXTRACT, _INV_CHUNK, _INV_EMBED and <project>_LOAD_REPORT unless you point the output port somewhere else. Give every step the SAME project name and caslib.\",\n\t\t\t\t\t\"visible\": \"\"\n\t\t\t\t},\n\t\t\t\t{\n\t\t\t\t\t\"id\": \"sectionPrereqs\",\n\t\t\t\t\t\"type\": \"section\",\n\t\t\t\t\t\"label\": \"Pre-requisites\",\n\t\t\t\t\t\"open\": false,\n\t\t\t\t\t\"visible\": \"\",\n\t\t\t\t\t\"children\": [\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"id\": \"textPrereqs\",\n\t\t\t\t\t\t\t\"type\": \"text\",\n\t\t\t\t\t\t\t\"text\": \"Tested on SAS Viya 2026 (Stable).\\n\\n* The rag_core runtime must be deployed to SAS Content (default: /SAS Agentic AI Accelerator/RAG/rag_core) with deploy-rag-content.ps1/.sh - keep that folder read-only for regular users.\\n* The compute context's Python needs the requests, swat and pandas packages (swat/pandas carry the pipeline tables to CAS - varchar columns, no 32k limit).\\n* CAS available; the runner needs write access to the tables caslib.\",\n\t\t\t\t\t\t\t\"visible\": \"\"\n\t\t\t\t\t\t}\n\t\t\t\t\t]\n\t\t\t\t},\n\t\t\t\t{\n\t\t\t\t\t\"id\": \"sectionChangelog\",\n\t\t\t\t\t\"type\": \"section\",\n\t\t\t\t\t\"label\": \"Changelog\",\n\t\t\t\t\t\"open\": true,\n\t\t\t\t\t\"visible\": \"\",\n\t\t\t\t\t\"children\": [\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"id\": \"textChangelog\",\n\t\t\t\t\t\t\t\"type\": \"text\",\n\t\t\t\t\t\t\t\"text\": \"* Version: 1.2 (29JUL2026)\\n      - SAS Content document sources; output tables land in the tables caslib; labelled columns; numeric and list-of-values fields; run summary in the log\\n* Version: 1.1 (28JUL2026)\\n      - Pipeline tables move to promoted CAS tables via SWAT (varchar, no 32k limit); automatic embed checkpoint\\n* Version: 1.0 (28JUL2026)\\n      - Initial version\",\n\t\t\t\t\t\t\t\"visible\": \"\"\n\t\t\t\t\t\t}\n\t\t\t\t\t]\n\t\t\t\t}\n\t\t\t]\n\t\t}\n\t],\n\t\"syntaxversion\": \"1.3.0\",\n\t\"values\": {\n\t\t\"_rgch_ragCorePath\": \"/SAS Agentic AI Accelerator/RAG/rag_core\",\n\t\t\"_rgch_persist\": {\n\t\t\t\"value\": \"1\",\n\t\t\t\"label\": \"Save to disk (survives a server restart)\"\n\t\t},\n\t\t\"_rgch_chunker\": {\n\t\t\t\"value\": \"recursive\",\n\t\t\t\"label\": \"Recursive (boundary-aware, with overlap)\"\n\t\t},\n\t\t\"_rgch_inputTokenLimit\": 256,\n\t\t\"_rgch_overlapTokens\": 30\n\t}\n}"}