{"name": "RAG - Chunk Documents.step", "displayName": "RAG - Chunk Documents.step", "localDisplayName": "RAG - Chunk Documents.step", "description": "Token-aware chunking of extracted RAG elements with deterministic chunk ids; chunk size is budgeted inside the embedding model's token window.", "localDescription": "Token-aware chunking of extracted RAG elements with deterministic chunk ids; chunk size is budgeted inside the embedding model's token window.", "properties": {}, "metadataVersion": 0.0, "version": 2, "type": "code", "flowMetadata": {"inputPorts": [{"name": "_rgch_elements", "displayName": "_rgch_elements", "localDisplayName": "_rgch_elements", "minEntries": 0, "maxEntries": 1, "defaultEntries": 0, "type": "table"}, {"name": "_rgch_inventory", "displayName": "_rgch_inventory", "localDisplayName": "_rgch_inventory", "minEntries": 0, "maxEntries": 1, "defaultEntries": 0, "type": "table"}], "outputPorts": [{"name": "_rgch_chunks", "displayName": "_rgch_chunks", "localDisplayName": "_rgch_chunks", "minEntries": 0, "maxEntries": 1, "defaultEntries": 0, "type": "table"}, {"name": "_rgch_invout", "displayName": "_rgch_invout", "localDisplayName": "_rgch_invout", "minEntries": 0, "maxEntries": 1, "defaultEntries": 0, "type": "table"}]}, "ui": "{\n\t\"showPageContentOnly\": true,\n\t\"pages\": [\n\t\t{\n\t\t\t\"id\": \"pageDefinition\",\n\t\t\t\"type\": \"page\",\n\t\t\t\"label\": \"Definition\",\n\t\t\t\"children\": [\n\t\t\t\t{\n\t\t\t\t\t\"id\": \"_rgch_info\",\n\t\t\t\t\t\"type\": \"text\",\n\t\t\t\t\t\"text\": \"Splits extracted elements into embedding-ready chunks. Sizes are counted in tokens and budgeted inside the embedding model's input window - set the token limit to your embedding model's Input_Token_Limit (256 for all_minilm_l6_v2).\",\n\t\t\t\t\t\"visible\": \"\"\n\t\t\t\t},\n\t\t\t\t{\n\t\t\t\t\t\"id\": \"_rgch_elements\",\n\t\t\t\t\t\"type\": \"inputtable\",\n\t\t\t\t\t\"label\": \"Elements (from RAG - Extract Text):\",\n\t\t\t\t\t\"required\": false,\n\t\t\t\t\t\"placeholder\": \"\",\n\t\t\t\t\t\"visible\": \"\"\n\t\t\t\t},\n\t\t\t\t{\n\t\t\t\t\t\"id\": \"_rgch_inventory\",\n\t\t\t\t\t\"type\": \"inputtable\",\n\t\t\t\t\t\"label\": \"Updated inventory (from RAG - Extract Text):\",\n\t\t\t\t\t\"required\": false,\n\t\t\t\t\t\"placeholder\": \"\",\n\t\t\t\t\t\"visible\": \"\"\n\t\t\t\t},\n\t\t\t\t{\n\t\t\t\t\t\"id\": \"_rgch_chunker\",\n\t\t\t\t\t\"type\": \"radiogroup\",\n\t\t\t\t\t\"label\": \"Chunker:\",\n\t\t\t\t\t\"items\": [\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"value\": \"recursive\",\n\t\t\t\t\t\t\t\"label\": \"Recursive (boundary-aware, with overlap)\"\n\t\t\t\t\t\t},\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"value\": \"paragraph\",\n\t\t\t\t\t\t\t\"label\": \"Paragraph\"\n\t\t\t\t\t\t}\n\t\t\t\t\t],\n\t\t\t\t\t\"visible\": \"\"\n\t\t\t\t},\n\t\t\t\t{\n\t\t\t\t\t\"id\": \"_rgch_inputTokenLimit\",\n\t\t\t\t\t\"type\": \"textfield\",\n\t\t\t\t\t\"label\": \"Embedding model token window (Input_Token_Limit):\",\n\t\t\t\t\t\"placeholder\": \"\",\n\t\t\t\t\t\"required\": false,\n\t\t\t\t\t\"visible\": \"\"\n\t\t\t\t},\n\t\t\t\t{\n\t\t\t\t\t\"id\": \"_rgch_overlapTokens\",\n\t\t\t\t\t\"type\": \"textfield\",\n\t\t\t\t\t\"label\": \"Chunk overlap in tokens (recursive only):\",\n\t\t\t\t\t\"placeholder\": \"\",\n\t\t\t\t\t\"required\": false,\n\t\t\t\t\t\"visible\": \"\"\n\t\t\t\t},\n\t\t\t\t{\n\t\t\t\t\t\"id\": \"_rgch_sectionAdvanced\",\n\t\t\t\t\t\"type\": \"section\",\n\t\t\t\t\t\"label\": \"Runtime\",\n\t\t\t\t\t\"open\": false,\n\t\t\t\t\t\"visible\": \"\",\n\t\t\t\t\t\"children\": [\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"id\": \"_rgch_ragCorePath\",\n\t\t\t\t\t\t\t\"type\": \"textfield\",\n\t\t\t\t\t\t\t\"label\": \"SAS Content folder holding rag_core:\",\n\t\t\t\t\t\t\t\"placeholder\": \"\",\n\t\t\t\t\t\t\t\"required\": false,\n\t\t\t\t\t\t\t\"visible\": \"\"\n\t\t\t\t\t\t}\n\t\t\t\t\t]\n\t\t\t\t},\n\t\t\t\t{\n\t\t\t\t\t\"id\": \"_rgch_chunks\",\n\t\t\t\t\t\"type\": \"outputtable\",\n\t\t\t\t\t\"label\": \"Chunk table output:\",\n\t\t\t\t\t\"required\": false,\n\t\t\t\t\t\"placeholder\": \"\",\n\t\t\t\t\t\"visible\": \"\"\n\t\t\t\t},\n\t\t\t\t{\n\t\t\t\t\t\"id\": \"_rgch_invout\",\n\t\t\t\t\t\"type\": \"outputtable\",\n\t\t\t\t\t\"label\": \"Updated inventory output (wire this one forward):\",\n\t\t\t\t\t\"required\": false,\n\t\t\t\t\t\"placeholder\": \"\",\n\t\t\t\t\t\"visible\": \"\"\n\t\t\t\t}\n\t\t\t]\n\t\t},\n\t\t{\n\t\t\t\"id\": \"pageAbout\",\n\t\t\t\"type\": \"page\",\n\t\t\t\"label\": \"About\",\n\t\t\t\"children\": [\n\t\t\t\t{\n\t\t\t\t\t\"id\": \"textAbout\",\n\t\t\t\t\t\"type\": \"text\",\n\t\t\t\t\t\"text\": \"RAG - Chunk Documents step\\n==========\\n\\nPure-python token-aware chunkers (no LangChain). Chunk ids are deterministic - sha1(doc_id + index + content_hash) - so re-ingesting an unchanged document is idempotent. The updated inventory carries each document's chunk count forward to the ledger.\\n\\nFlow wiring: RAG - List Documents \u2192 RAG - Extract Text (inventory) \u2192 RAG - Chunk Documents (elements + updated inventory) \u2192 RAG - Embed Chunks (chunks) \u2192 RAG - Load Vector Store (embedded chunks + updated inventory). Always pass each step's UPDATED inventory forward so per-document failures and chunk counts reach the ledger.\",\n\t\t\t\t\t\"visible\": \"\"\n\t\t\t\t},\n\t\t\t\t{\n\t\t\t\t\t\"id\": \"sectionPrereqs\",\n\t\t\t\t\t\"type\": \"section\",\n\t\t\t\t\t\"label\": \"Pre-requisites\",\n\t\t\t\t\t\"open\": false,\n\t\t\t\t\t\"visible\": \"\",\n\t\t\t\t\t\"children\": [\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"id\": \"textPrereqs\",\n\t\t\t\t\t\t\t\"type\": \"text\",\n\t\t\t\t\t\t\t\"text\": \"Tested on SAS Viya 2026 (Stable).\\n\\n* The rag_core runtime must be deployed to SAS Content (default: /SAS Agentic AI Accelerator/RAG/rag_core) with deploy-rag-content.ps1/.sh - keep that folder read-only for regular users.\\n* The compute context's Python needs the requests package.\",\n\t\t\t\t\t\t\t\"visible\": \"\"\n\t\t\t\t\t\t}\n\t\t\t\t\t]\n\t\t\t\t},\n\t\t\t\t{\n\t\t\t\t\t\"id\": \"sectionChangelog\",\n\t\t\t\t\t\"type\": \"section\",\n\t\t\t\t\t\"label\": \"Changelog\",\n\t\t\t\t\t\"open\": true,\n\t\t\t\t\t\"visible\": \"\",\n\t\t\t\t\t\"children\": [\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"id\": \"textChangelog\",\n\t\t\t\t\t\t\t\"type\": \"text\",\n\t\t\t\t\t\t\t\"text\": \"* Version: 1.0 (28JUL2026)\\n      - Initial version\",\n\t\t\t\t\t\t\t\"visible\": \"\"\n\t\t\t\t\t\t}\n\t\t\t\t\t]\n\t\t\t\t}\n\t\t\t]\n\t\t}\n\t],\n\t\"syntaxversion\": \"1.3.0\",\n\t\"values\": {\n\t\t\"_rgch_chunker\": {\n\t\t\t\"value\": \"recursive\",\n\t\t\t\"label\": \"Recursive (boundary-aware, with overlap)\"\n\t\t},\n\t\t\"_rgch_inputTokenLimit\": \"256\",\n\t\t\"_rgch_overlapTokens\": \"30\",\n\t\t\"_rgch_ragCorePath\": \"/SAS Agentic AI Accelerator/RAG/rag_core\"\n\t}\n}", "templates": {"SAS": "/******************************************************************************\n * Copyright \u00a9 2026, SAS Institute Inc., Cary, NC, USA.  All Rights Reserved.\n * SPDX-License-Identifier: Apache-2.0\n *\n * RAG - Chunk Documents: token-aware chunking of extracted elements. The\n * chunk size is budgeted INSIDE the embedding model's token window (overlap\n * included) so no chunk is ever silently truncated by the model.\n * Thin shell over rag_core.steps.run_chunk - see the About tab.\n ******************************************************************************/\n%macro _rgch_setup;\n    %if not %symexist(_rgch_chunks) %then %global _rgch_chunks;\n    %if %length(%superq(_rgch_chunks)) EQ 0 %then %let _rgch_chunks = WORK.RAG_CHUNKS;\n    %if not %symexist(_rgch_invout) %then %global _rgch_invout;\n    %if %length(%superq(_rgch_invout)) EQ 0 %then %let _rgch_invout = WORK.RAG_INVENTORY_CHUNKED;\n%mend _rgch_setup;\n%_rgch_setup;\n\n%let _rgch_viyaHost = %sysfunc(getoption(SERVICESBASEURL));\n%let _rgch_rc = 1;\n%let _rgch_error = The Python program did not run.;\n%let _rgch_summary = ;\n%let _rgch_nch = 0;\n%let _rgch_ninv = 0;\n\n%macro _rgch_export(portvar, file);\n    %if %symexist(&portvar.) %then %do;\n        %if %length(%superq(&&portvar.)) GT 0 %then %do;\n            %if %sysfunc(exist(&&&portvar..)) %then %do;\n                filename _rgch_io \"%sysfunc(pathname(work))/&file.\";\n                proc json out=_rgch_io noSASTags;\n                    export &&&portvar..;\n                run; quit;\n                filename _rgch_io clear;\n            %end;\n        %end;\n    %end;\n%mend _rgch_export;\n%_rgch_export(_rgch_elements, rgch_elements_in.json);\n%_rgch_export(_rgch_inventory, rgch_inventory_in.json);\n\nproc python restart;\nsubmit;\ndef main():\n    import json\n    import os\n    import sys\n    import tempfile\n    import time\n    import traceback\n\n    def sas_safe(text):\n        \"\"\"Strings crossing into SAS.logMessage/SAS.symput are embedded into\n        generated SAS statements - quotes and macro characters corrupt the\n        code stream (verified live). EVERY such string goes through here.\"\"\"\n        cleaned = str(text)\n        for ch in (\"'\", '\"', \"%\", \"&\", \";\"):\n            cleaned = cleaned.replace(ch, \" \")\n        return cleaned\n\n    def M(msg):\n        SAS.logMessage(\"RAGCHUNK \" + sas_safe(msg))\n\n    try:\n        import requests\n    except Exception:\n        SAS.symput(\"_rgch_error\", \"The Python environment of this compute \"\n                                   \"context lacks the requests package - see \"\n                                   \"the RAG administration guide.\")\n        return\n\n    BASE = str(SAS.symget(\"_rgch_viyaHost\") or \"\").rstrip(\"/\")\n    TOKEN = os.environ.get(\"SAS_SERVICES_TOKEN\", \"\")\n    AUTH = {\"Authorization\": \"Bearer \" + TOKEN}\n    VERIFY = os.environ.get(\"SSLCALISTLOC\") or os.environ.get(\"CAS_CLIENT_SSL_CA_LIST\") or True\n    WORKPATH = SAS.workpath if SAS.workpath.endswith(os.sep) else SAS.workpath + os.sep\n\n    P = {name: str(SAS.symget(name) or \"\").strip() for name in [\n        \"_rgch_chunker\",\n        \"_rgch_inputTokenLimit\",\n        \"_rgch_overlapTokens\",\n        \"_rgch_ragCorePath\",\n    ]}\n\n    def read_rows(filename, missing_message):\n        path = WORKPATH + filename\n        if not os.path.exists(path):\n            raise RuntimeError(missing_message)\n        with open(path, \"r\", encoding=\"utf-8\") as fh:\n            data = json.load(fh)\n        rows = []\n        for row in data if isinstance(data, list) else []:\n            rows.append({str(k).lower(): v for k, v in row.items()})\n        return rows\n\n    def write_rows(filename, rows, columns, numeric=()):\n        out = []\n        for row in rows:\n            rec = {}\n            for column in columns:\n                value = row.get(column)\n                if column in numeric:\n                    try:\n                        rec[column] = float(value or 0)\n                    except Exception:\n                        rec[column] = 0.0\n                else:\n                    rec[column] = \"\" if value is None else str(value)\n            out.append(rec)\n        with open(WORKPATH + filename, \"w\", encoding=\"utf-8\") as fh:\n            json.dump(out, fh)\n        return len(out)\n\n    try:\n        # ---- rag_core bootstrap: download the governed SAS Content folder --\n        def get_json(endpoint, **params):\n            response = requests.get(BASE + endpoint, params=params, headers=AUTH,\n                                    verify=VERIFY, timeout=(5, 30))\n            response.raise_for_status()\n            return response.json()\n\n        def download_folder(folder_id, local_dir):\n            os.makedirs(local_dir, exist_ok=True)\n            count = 0\n            members = get_json(f\"/folders/folders/{folder_id}/members\", limit=200)\n            for member in members.get(\"items\", []):\n                uri = member.get(\"uri\", \"\")\n                if \"/files/files/\" in uri:\n                    content = requests.get(BASE + uri + \"/content\", headers=AUTH,\n                                           verify=VERIFY, timeout=(5, 60))\n                    content.raise_for_status()\n                    with open(os.path.join(local_dir, member[\"name\"]), \"wb\") as fh:\n                        fh.write(content.content)\n                    count += 1\n                elif \"/folders/folders/\" in uri:\n                    count += download_folder(uri.rsplit(\"/\", 1)[-1],\n                                             os.path.join(local_dir, member[\"name\"]))\n            return count\n\n        core_path = P[\"_rgch_ragCorePath\"] or \"/SAS Agentic AI Accelerator/RAG/rag_core\"\n        root = requests.get(BASE + \"/folders/folders/@item\",\n                            params={\"path\": core_path}, headers=AUTH,\n                            verify=VERIFY, timeout=(5, 30))\n        if root.status_code != 200:\n            raise RuntimeError(f\"rag_core folder {core_path} not found \"\n                               f\"(HTTP {root.status_code}) - deploy it per the \"\n                               \"administration guide\")\n        staging = tempfile.mkdtemp(prefix=\"rag_core_\")\n        n_files = download_folder(root.json()[\"id\"], os.path.join(staging, \"rag_core\"))\n        sys.path.insert(0, staging)\n        import rag_core\n        M(f\"rag_core {rag_core.RAG_CORE_VERSION} bootstrapped ({n_files} files)\")\n\n        def chunk_to_row(chunk):\n            row = dict(chunk)\n            for column in (\"span\", \"tags\", \"entities\", \"relations\", \"embedding\"):\n                value = chunk.get(column)\n                row[column] = json.dumps(value) if value not in (None, \"\", {}) else \"\"\n            return row\n\n        def row_to_chunk(row):\n            chunk = dict(row)\n            chunk[\"chunk_index\"] = int(float(row.get(\"chunk_index\") or 0))\n            for column in (\"span\", \"entities\", \"relations\", \"embedding\"):\n                chunk[column] = json.loads(row[column]) if row.get(column) else None\n            chunk[\"tags\"] = json.loads(row[\"tags\"]) if row.get(\"tags\") else {}\n            for column in (\"heading_path\", \"prev_id\", \"next_id\", \"context_header\"):\n                chunk[column] = row.get(column) or None\n            return chunk\n\n        from rag_core.steps import CHUNK_COLUMNS, LEDGER_COLUMNS, run_chunk\n\n        inventory_columns = LEDGER_COLUMNS + [\"extractor\"]\n        elements = read_rows(\"rgch_elements_in.json\",\n                             \"the elements input port is not connected - \"\n                             \"wire the RAG - Extract Text elements output \"\n                             \"into this step\")\n        inventory = read_rows(\"rgch_inventory_in.json\",\n                              \"the inventory input port is not connected - \"\n                              \"wire the RAG - Extract Text updated-inventory \"\n                              \"output into this step\")\n        pipeline_version = \"v1\"\n        for row in inventory:\n            if row.get(\"pipeline_version\"):\n                pipeline_version = row[\"pipeline_version\"]\n                break\n\n        chunks = run_chunk(elements, inventory,\n                           P[\"_rgch_chunker\"] or \"recursive\",\n                           int(float(P[\"_rgch_inputTokenLimit\"] or 256)),\n                           pipeline_version,\n                           overlap_tokens=int(float(P[\"_rgch_overlapTokens\"] or 30)),\n                           log=M)\n        n_chunks = write_rows(\"rgch_chunks_out.json\",\n                              [chunk_to_row(c) for c in chunks],\n                              CHUNK_COLUMNS, numeric=(\"chunk_index\",))\n        n_inventory = write_rows(\"rgch_inventory_out.json\", inventory,\n                                 inventory_columns, numeric=(\"chunk_count\",))\n        SAS.symput(\"_rgch_nch\", str(n_chunks))\n        SAS.symput(\"_rgch_ninv\", str(n_inventory))\n        n_docs = len({c[\"doc_id\"] for c in chunks})\n        summary = f\"{n_chunks} chunks from {n_docs} documents\"\n        M(summary)\n        SAS.symput(\"_rgch_summary\", sas_safe(summary)[:400])\n\n        SAS.symput(\"_rgch_rc\", \"0\")\n    except Exception as error:\n        error_text = f\"{type(error).__name__}: {error}\"\n        M(\"failed: \" + sas_safe(error_text))\n        print(traceback.format_exc())\n        SAS.symput(\"_rgch_error\", sas_safe(error_text)[:500])\n\n\nmain()\nendsubmit;\nrun; quit;\nproc python terminate;\nrun; quit;\n\n%macro _rgch_emit_chunks;\n    %if &_rgch_rc. NE 0 %then %return;\n    %if &_rgch_nch. GT 0 %then %do;\n        filename rgchcho \"%sysfunc(pathname(work))/rgch_chunks_out.json\";\n        libname rgchchj json fileref=rgchcho;\n        data &_rgch_chunks.(compress=yes);\n            length chunk_id $ 40 doc_id $ 40 source_uri $ 1024 chunk_index 8\n                   content $ 32000 content_hash $ 64 extractor $ 64\n                   pipeline_version $ 32 ingested_at $ 24 span $ 512\n                   heading_path $ 1024 tags $ 4096 prev_id $ 40 next_id $ 40\n                   context_header $ 4096 entities $ 8192 relations $ 8192\n                   embedding $ 32767;\n            set rgchchj.root(drop=ordinal_root);\n        run;\n        libname rgchchj clear;\n        filename rgchcho clear;\n    %end;\n    %else %do;\n        data &_rgch_chunks.(compress=yes);\n            length chunk_id $ 40 doc_id $ 40 source_uri $ 1024 chunk_index 8\n                   content $ 32000 content_hash $ 64 extractor $ 64\n                   pipeline_version $ 32 ingested_at $ 24 span $ 512\n                   heading_path $ 1024 tags $ 4096 prev_id $ 40 next_id $ 40\n                   context_header $ 4096 entities $ 8192 relations $ 8192\n                   embedding $ 32767;\n            call missing(of _all_);\n            stop;\n        run;\n    %end;\n%mend _rgch_emit_chunks;\n%_rgch_emit_chunks;\n\n%macro _rgch_emit_inventory;\n    %if &_rgch_rc. NE 0 %then %return;\n    %if &_rgch_ninv. GT 0 %then %do;\n        filename rgchino \"%sysfunc(pathname(work))/rgch_inventory_out.json\";\n        libname rgchinj json fileref=rgchino;\n        data &_rgch_invout.(compress=yes);\n            length doc_id $ 40 source_uri $ 1024 source_kind $ 16\n                   content_hash $ 64 mtime $ 32 status $ 12 error_text $ 512\n                   pipeline_version $ 32 config_hash $ 32 chunk_count 8\n                   run_id $ 32 updated_at $ 24 extractor $ 64;\n            set rgchinj.root(drop=ordinal_root);\n        run;\n        libname rgchinj clear;\n        filename rgchino clear;\n    %end;\n    %else %do;\n        data &_rgch_invout.(compress=yes);\n            length doc_id $ 40 source_uri $ 1024 source_kind $ 16\n                   content_hash $ 64 mtime $ 32 status $ 12 error_text $ 512\n                   pipeline_version $ 32 config_hash $ 32 chunk_count 8\n                   run_id $ 32 updated_at $ 24 extractor $ 64;\n            call missing(of _all_);\n            stop;\n        run;\n    %end;\n%mend _rgch_emit_inventory;\n%_rgch_emit_inventory;\n\ndata _null_;\n    if \"&_rgch_rc.\" ne \"0\" then do;\n        putLog \"ERROR: RAG - Chunk Documents failed: %superq(_rgch_error)\";\n        abort 42;\n    end;\n    putLog \"NOTE: RAG - Chunk Documents: %superq(_rgch_summary)\";\nrun;"}}