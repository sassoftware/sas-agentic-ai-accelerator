{"description": "Embeds RAG chunks through the governed SCR embedding container with thread-pooled calls; vectors for unchanged chunk ids are reused from the previous run automatically.", "displayName": "RAG - Embed Chunks.step", "flowMetadata": {"inputPorts": [{"name": "_rgem_inventory", "displayName": "_rgem_inventory", "minEntries": 1, "maxEntries": 1, "type": "table", "id": "_rgem_inventory", "label": "_rgem_inventory"}], "outputPorts": [{"name": "_rgem_invout", "displayName": "_rgem_invout", "minEntries": 1, "maxEntries": 1, "columnDelta": null, "type": "table"}]}, "metadataVersion": 1, "name": "RAG - Embed Chunks.step", "properties": {}, "templates": {"SAS": "/******************************************************************************\n * Copyright \u00a9 2026, SAS Institute Inc., Cary, NC, USA.  All Rights Reserved.\n * SPDX-License-Identifier: Apache-2.0\n *\n * RAG - Embed Chunks: embed every chunk in <project>_CHUNKS through the\n * governed SCR embedding container into the promoted CAS table\n * <project>_EMBEDDED. Vectors already present in that table for unchanged\n * chunk ids are reused, not re-called - an interrupted run resumes for free.\n * Thin shell over rag_core.steps.run_embed - see the About tab.\n ******************************************************************************/\n%macro _rgem_setup;\n    %if not %symexist(_rgem_ragProject) %then %global _rgem_ragProject;\n    %if not %symexist(_rgem_tablesCaslib) %then %global _rgem_tablesCaslib;\n%mend _rgem_setup;\n%_rgem_setup;\n%macro _rgem_inherit;\n    %local dsid vproject vcaslib rc;\n    %if %symexist(_rgem_inventory) %then\n    %if %length(%superq(_rgem_inventory)) NE 0 %then %do;\n        %if %sysfunc(exist(&_rgem_inventory.)) %then %do;\n            %let dsid = %sysfunc(open(&_rgem_inventory., i));\n            %if &dsid. NE 0 %then %do;\n                %let vproject = %sysfunc(varnum(&dsid., rag_project));\n                %let vcaslib = %sysfunc(varnum(&dsid., tables_caslib));\n                %if %sysfunc(fetch(&dsid.)) EQ 0 %then %do;\n                    %if &vproject. GT 0 %then\n                        %let _rgem_ragProject = %sysfunc(getvarc(&dsid., &vproject.));\n                    %if &vcaslib. GT 0 %then\n                        %let _rgem_tablesCaslib = %sysfunc(getvarc(&dsid., &vcaslib.));\n                %end;\n                %let rc = %sysfunc(close(&dsid.));\n            %end;\n        %end;\n    %end;\n    %if %length(%superq(_rgem_ragProject)) EQ 0 %then %do;\n        data _null_;\n            putLog \"ERROR: RAG - Embed Chunks: the inventory does not name a RAG \"\n                   \"project - wire the output of RAG - List Documents into \"\n                   \"this step (steps older than version 1.2 do not carry it)\";\n            abort 42;\n        run;\n    %end;\n    %if %length(%superq(_rgem_tablesCaslib)) EQ 0 %then\n        %let _rgem_tablesCaslib = casuser;\n%mend _rgem_inherit;\n%_rgem_inherit;\n%if not %symexist(_rgem_invout) %then %global _rgem_invout;\n%if %length(%superq(_rgem_invout)) EQ 0 %then\n    %let _rgem_invout = rgemout.&_rgem_ragProject._INV_EMBED;\n\n%let _rgem_viyaHost = %sysfunc(getoption(SERVICESBASEURL));\n%let _rgem_rc = 1;\n%let _rgem_error = The Python program did not run.;\n%let _rgem_summary = ;\n%let _rgem_nrows = 0;\n%let _rgem_ninv = 0;\n\n/* One CAS session for the whole step: created here, reused by\n   SWAT inside proc python, promote+save done by proc casutil.\n   rgemout is where the step's OUTPUT TABLE lands by default -\n   the same caslib as the pipeline tables, so a flow leaves its\n   intermediate results next to each other. */\ncas rgemcas uuidmac=_rgem_casuuid;\n%let _rgem_cashost = %sysfunc(getoption(CASHOST));\n%let _rgem_casport = %sysfunc(getoption(CASPORT));\nlibname rgemout cas caslib=\"&_rgem_tablesCaslib.\" sessref=rgemcas;\n\n%macro _rgem_export(portvar, file);\n    %if %symexist(&portvar.) %then %do;\n        %if %length(%superq(&&portvar.)) GT 0 %then %do;\n            %if %sysfunc(exist(&&&portvar..)) %then %do;\n                filename _rgem_io \"%sysfunc(pathname(work))/&file.\";\n                proc json out=_rgem_io noSASTags;\n                    export &&&portvar..;\n                run; quit;\n                filename _rgem_io clear;\n            %end;\n        %end;\n    %end;\n%mend _rgem_export;\n%_rgem_export(_rgem_inventory, rgem_inventory_in.json);\n\nproc python restart;\nsubmit;\ndef main():\n    import json\n    import os\n    import sys\n    import tempfile\n    import time\n    import traceback\n\n    def sas_safe(text):\n        \"\"\"Strings crossing into SAS.logMessage/SAS.symput are embedded into\n        generated SAS statements - quotes and macro characters corrupt the\n        code stream (verified live). EVERY such string goes through here.\"\"\"\n        cleaned = str(text)\n        for ch in (\"'\", '\"', \"%\", \"&\", \";\"):\n            cleaned = cleaned.replace(ch, \" \")\n        return cleaned\n\n    def M(msg):\n        SAS.logMessage(\"RAGEMBED \" + sas_safe(msg))\n\n    try:\n        import requests\n    except Exception:\n        SAS.symput(\"_rgem_error\", \"The Python environment of this compute \"\n                                   \"context lacks the requests package - see \"\n                                   \"the RAG administration guide.\")\n        return\n    try:\n        import pandas as pd\n        import swat\n    except Exception:\n        SAS.symput(\"_rgem_error\", \"The Python environment of this compute \"\n                                   \"context lacks the swat/pandas packages \"\n                                   \"required for the CAS table transport - \"\n                                   \"see the RAG administration guide.\")\n        return\n\n    BASE = str(SAS.symget(\"_rgem_viyaHost\") or \"\").rstrip(\"/\")\n    TOKEN = os.environ.get(\"SAS_SERVICES_TOKEN\", \"\")\n    AUTH = {\"Authorization\": \"Bearer \" + TOKEN}\n    VERIFY = os.environ.get(\"SSLCALISTLOC\") or os.environ.get(\"CAS_CLIENT_SSL_CA_LIST\") or True\n    WORKPATH = SAS.workpath if SAS.workpath.endswith(os.sep) else SAS.workpath + os.sep\n\n    P = {name: str(SAS.symget(name) or \"\").strip() for name in [\n        \"_rgem_scrEndpoint\",\n        \"_rgem_embedModel\",\n        \"_rgem_deploymentType\",\n        \"_rgem_replicas\",\n        \"_rgem_ragProject\",\n        \"_rgem_tablesCaslib\",\n        \"_rgem_ragCorePath\",\n    ]}\n\n    def read_rows(filename, missing_message):\n        path = WORKPATH + filename\n        if not os.path.exists(path):\n            raise RuntimeError(missing_message)\n        with open(path, \"r\", encoding=\"utf-8\") as fh:\n            data = json.load(fh)\n        rows = []\n        for row in data if isinstance(data, list) else []:\n            rows.append({str(k).lower(): v for k, v in row.items()})\n        return rows\n\n    def clean_path(raw):\n        \"\"\"Path-selector values arrive scheme-prefixed (sasserver:/...,\n        sascontent:/...); strip the scheme off.\"\"\"\n        value = str(raw or \"\").strip()\n        for scheme in (\"sascontent:\", \"sasserver:\"):\n            if value.lower().startswith(scheme):\n                return value[len(scheme):]\n        return value\n\n    STARTED = time.time()\n    SUMMARY = []\n\n    def summarize(line):\n        \"\"\"One line of the step's log summary (SAS prints them at the end).\"\"\"\n        SUMMARY.append(str(line))\n\n    def publish_summary(target):\n        elapsed = time.time() - STARTED\n        summarize(f\"elapsed {elapsed:.1f}s\")\n        SAS.symput(target, sas_safe(\" | \".join(SUMMARY))[:1500])\n\n    def write_rows(filename, rows, columns, numeric=()):\n        out = []\n        for row in rows:\n            rec = {}\n            for column in columns:\n                value = row.get(column)\n                if column in numeric:\n                    try:\n                        rec[column] = float(value or 0)\n                    except Exception:\n                        rec[column] = 0.0\n                else:\n                    rec[column] = \"\" if value is None else str(value)\n            out.append(rec)\n        with open(WORKPATH + filename, \"w\", encoding=\"utf-8\") as fh:\n            json.dump(out, fh)\n        return len(out)\n\n    try:\n        # ---- CAS: reuse the session the step created in SAS ---------------\n        # (sas-studio-custom-steps: Reuse-CAS-session-from-SWAT)\n        import re as _re\n        os.environ.setdefault(\"CAS_CLIENT_SSL_CA_LIST\",\n                              os.environ.get(\"SSLCALISTLOC\", \"\"))\n        conn = swat.CAS(hostname=str(SAS.symget(\"_rgem_cashost\") or \"\"),\n                        port=int(float(SAS.symget(\"_rgem_casport\") or 5570)),\n                        password=TOKEN,\n                        session=str(SAS.symget(\"_rgem_casuuid\") or \"\"))\n        CASLIB = P[\"_rgem_tablesCaslib\"] or \"casuser\"\n        if not _re.match(r\"^[A-Za-z][A-Za-z0-9_]{0,19}$\",\n                         P[\"_rgem_ragProject\"] or \"\"):\n            raise RuntimeError(\n                \"ragProject must be 1-20 characters (letters, digits, \"\n                \"underscores, starting with a letter) so every \"\n                \"project_suffix table name stays within the 32 characters \"\n                \"SAS Studio displays\")\n\n        def project_table(suffix):\n            return P[\"_rgem_ragProject\"] + suffix\n\n        def stamp(rows):\n            \"\"\"Every inventory row names its pipeline, so the next step\n            inherits the project and caslib instead of asking again.\"\"\"\n            for row in rows:\n                row[\"rag_project\"] = P[\"_rgem_ragProject\"]\n                row[\"tables_caslib\"] = CASLIB\n            return rows\n\n        def cas_read(name, required_message=None):\n            \"\"\"Read a pipeline table into lower-cased row dicts; absent\n            table = empty (the pipeline's empty state) unless required.\"\"\"\n            if not conn.table.tableExists(caslib=CASLIB, name=name).exists:\n                if required_message:\n                    raise RuntimeError(required_message)\n                return []\n            frame = conn.CASTable(name, caslib=CASLIB).to_frame()\n            rows = []\n            for record in frame.to_dict(\"records\"):\n                row = {}\n                for key, value in record.items():\n                    row[str(key).lower()] = None if pd.isna(value) else value\n                rows.append(row)\n            return rows\n\n        def label_columns(name, columns):\n            \"\"\"Put the shipped column labels on a CAS table - they survive\n            the promote, so the pipeline tables read without the schema.\"\"\"\n            try:\n                from rag_core.steps import column_labels\n                labels = column_labels(columns)\n                if labels:\n                    conn.table.alterTable(\n                        caslib=CASLIB, name=name,\n                        columns=[{\"name\": column, \"label\": label}\n                                 for column, label in labels.items()])\n            except Exception as exc:\n                M(f\"column labels not applied to {name}: {exc}\")\n\n        def cas_stage(name, rows, columns, numeric=()):\n            \"\"\"Upload the session-scope staging table <name>_S with varchar\n            columns (no 32k limit); the SAS side swaps it into the promoted\n            global table and saves it, so the previous state survives a\n            mid-step failure.\"\"\"\n            if not rows:\n                return 0\n            data = []\n            for row in rows:\n                rec = []\n                for column in columns:\n                    value = row.get(column)\n                    if column in numeric:\n                        try:\n                            rec.append(float(value or 0))\n                        except Exception:\n                            rec.append(0.0)\n                    else:\n                        rec.append(\"\" if value is None else str(value))\n                data.append(rec)\n            frame = pd.DataFrame(data, columns=list(columns))\n            spec = [{\"name\": column,\n                     \"type\": \"double\" if column in numeric else \"varchar\"}\n                    for column in columns]\n            conn.upload_frame(frame,\n                              casout={\"name\": name + \"_S\", \"caslib\": CASLIB,\n                                      \"replace\": True},\n                              importoptions={\"fileType\": \"csv\",\n                                             \"allowEmbeddedNewLines\": True,\n                                             \"vars\": spec})\n            label_columns(name + \"_S\", columns)\n            return len(rows)\n\n        # ---- rag_core bootstrap: download the governed SAS Content folder --\n        def get_json(endpoint, **params):\n            response = requests.get(BASE + endpoint, params=params, headers=AUTH,\n                                    verify=VERIFY, timeout=(5, 30))\n            response.raise_for_status()\n            return response.json()\n\n        def download_folder(folder_id, local_dir):\n            os.makedirs(local_dir, exist_ok=True)\n            count = 0\n            members = get_json(f\"/folders/folders/{folder_id}/members\", limit=200)\n            for member in members.get(\"items\", []):\n                uri = member.get(\"uri\", \"\")\n                if \"/files/files/\" in uri:\n                    content = requests.get(BASE + uri + \"/content\", headers=AUTH,\n                                           verify=VERIFY, timeout=(5, 60))\n                    content.raise_for_status()\n                    with open(os.path.join(local_dir, member[\"name\"]), \"wb\") as fh:\n                        fh.write(content.content)\n                    count += 1\n                elif \"/folders/folders/\" in uri:\n                    count += download_folder(uri.rsplit(\"/\", 1)[-1],\n                                             os.path.join(local_dir, member[\"name\"]))\n            return count\n\n        core_path = (clean_path(P[\"_rgem_ragCorePath\"])\n                     or \"/SAS Agentic AI Accelerator/RAG/rag_core\")\n        root = requests.get(BASE + \"/folders/folders/@item\",\n                            params={\"path\": core_path}, headers=AUTH,\n                            verify=VERIFY, timeout=(5, 30))\n        if root.status_code != 200:\n            raise RuntimeError(f\"rag_core folder {core_path} not found \"\n                               f\"(HTTP {root.status_code}) - deploy it per the \"\n                               \"administration guide\")\n        staging = tempfile.mkdtemp(prefix=\"rag_core_\")\n        n_files = download_folder(root.json()[\"id\"], os.path.join(staging, \"rag_core\"))\n        sys.path.insert(0, staging)\n        import rag_core\n        M(f\"rag_core {rag_core.RAG_CORE_VERSION} bootstrapped ({n_files} files)\")\n\n        def chunk_to_row(chunk):\n            row = dict(chunk)\n            for column in (\"span\", \"tags\", \"entities\", \"relations\", \"embedding\"):\n                value = chunk.get(column)\n                row[column] = json.dumps(value) if value not in (None, \"\", {}) else \"\"\n            return row\n\n        def row_to_chunk(row):\n            chunk = dict(row)\n            chunk[\"chunk_index\"] = int(float(row.get(\"chunk_index\") or 0))\n            for column in (\"span\", \"entities\", \"relations\", \"embedding\"):\n                chunk[column] = json.loads(row[column]) if row.get(column) else None\n            chunk[\"tags\"] = json.loads(row[\"tags\"]) if row.get(\"tags\") else {}\n            for column in (\"heading_path\", \"prev_id\", \"next_id\", \"context_header\"):\n                chunk[column] = row.get(column) or None\n            return chunk\n\n        from rag_core.scr import EmbeddingClient\n        from rag_core.steps import CHUNK_COLUMNS, INVENTORY_COLUMNS, run_embed\n\n        inventory_columns = INVENTORY_COLUMNS\n        inventory = read_rows(\"rgem_inventory_in.json\",\n                              \"the inventory input port is not connected - \"\n                              \"wire the RAG - Chunk Documents \"\n                              \"updated-inventory output into this step\")\n        chunks = [row_to_chunk(row)\n                  for row in cas_read(project_table(\"_CHUNKS\"))]\n        if not chunks:\n            n_inventory = write_rows(\"rgem_inventory_out.json\", stamp(inventory),\n                                     inventory_columns,\n                                     numeric=(\"chunk_count\",))\n            SAS.symput(\"_rgem_ninv\", str(n_inventory))\n            SAS.symput(\"_rgem_nrows\", \"-1\")\n            summarize(\"no chunks pending - nothing to embed\")\n            summarize(f\"{CASLIB}.{project_table('_EMBEDDED')} left untouched, \"\n                      \"so its vectors stay available for the next run\")\n            publish_summary(\"_rgem_summary\")\n        else:\n            # automatic checkpoint: reuse vectors from the previous run's\n            # promoted table for chunk ids that still exist (deterministic\n            # ids guarantee identical content)\n            current_ids = {chunk[\"chunk_id\"] for chunk in chunks}\n            previous = {}\n            for row in cas_read(project_table(\"_EMBEDDED\")):\n                if row.get(\"embedding\") and row.get(\"chunk_id\") in current_ids:\n                    previous[row[\"chunk_id\"]] = row\n\n            endpoint = P[\"_rgem_scrEndpoint\"] or BASE + \"/llm\"\n            model = P[\"_rgem_embedModel\"] or \"all_minilm_l6_v2\"\n            client = EmbeddingClient(endpoint, model,\n                                     deployment_type=P[\"_rgem_deploymentType\"] or \"k8s\",\n                                     verify_ssl=VERIFY)\n            dims = client.smoke()\n            M(f\"embedding endpoint ready ({dims} dims)\")\n\n            # the container serves ~4 concurrent calls per replica before\n            # queueing, so the step asks for replicas and does the arithmetic\n            replicas = max(1, int(float(P[\"_rgem_replicas\"] or 1)))\n            workers = replicas * 4\n            embedded, failures = run_embed(chunks, client,\n                                           already_embedded=set(previous),\n                                           max_workers=workers, log=M)\n            if not embedded and not previous:\n                first_error = failures[0][1] if failures else \"unknown\"\n                raise RuntimeError(\"no chunk could be embedded - first error: \"\n                                   + first_error)\n\n            rows_out = list(previous.values())\n            for chunk in embedded:\n                rows_out.append(chunk_to_row(chunk))\n            n_rows = cas_stage(project_table(\"_EMBEDDED\"), rows_out,\n                               CHUNK_COLUMNS, numeric=(\"chunk_index\",))\n            n_inventory = write_rows(\"rgem_inventory_out.json\", stamp(inventory),\n                                     inventory_columns,\n                                     numeric=(\"chunk_count\",))\n            SAS.symput(\"_rgem_nrows\", str(n_rows))\n            SAS.symput(\"_rgem_ninv\", str(n_inventory))\n            usage = getattr(client, \"usage\", {}) or {}\n            summarize(f\"model {model} at {endpoint} ({dims} dimensions)\")\n            summarize(f\"{replicas} replica(s) -> {workers} parallel calls\")\n            summarize(f\"{len(embedded)} chunks embedded, {len(previous)} \"\n                      f\"reused from the previous run, {len(failures)} failed\")\n            if usage.get(\"calls\"):\n                summarize(f\"{usage['calls']} container calls in \"\n                          f\"{usage.get('run_time', 0):.1f}s\")\n            summarize(f\"{n_rows} rows written to \"\n                      f\"{CASLIB}.{project_table('_EMBEDDED')}\")\n            publish_summary(\"_rgem_summary\")\n\n        try:\n            conn.close(close_session=False)\n        except Exception:\n            pass\n        SAS.symput(\"_rgem_rc\", \"0\")\n    except Exception as error:\n        error_text = f\"{type(error).__name__}: {error}\"\n        M(\"failed: \" + sas_safe(error_text))\n        print(traceback.format_exc())\n        SAS.symput(\"_rgem_error\", sas_safe(error_text)[:500])\n\n\nmain()\nendsubmit;\nrun; quit;\nproc python terminate;\nrun; quit;\n\n%macro _rgem_swap(suffix, count);\n    %if &_rgem_rc. NE 0 %then %return;\n    %if &count. LT 0 %then %return;\n    proc casutil sessref=rgemcas incaslib=\"&_rgem_tablesCaslib.\"\n                 outcaslib=\"&_rgem_tablesCaslib.\";\n        droptable casdata=\"&_rgem_ragProject.&suffix.\" quiet;\n        %if &count. GT 0 %then %do;\n            promote casdata=\"&_rgem_ragProject.&suffix._S\"\n                    casout=\"&_rgem_ragProject.&suffix.\";\n            save casdata=\"&_rgem_ragProject.&suffix.\"\n                 casout=\"&_rgem_ragProject.&suffix.\" replace;\n        %end;\n        %else %do;\n            deletesource casdata=\"&_rgem_ragProject.&suffix..sashdat\" quiet;\n        %end;\n    quit;\n%mend _rgem_swap;\n%_rgem_swap(_EMBEDDED, &_rgem_nrows.);\n\n%macro _rgem_emit_inventory;\n    %if &_rgem_rc. NE 0 %then %return;\n    %local lib table opts;\n    %let lib = %upcase(%scan(&_rgem_invout., 1, .));\n    %let table = %scan(&_rgem_invout., 2, .);\n    %if &lib. EQ %upcase(rgemout) %then %do;\n        proc casutil sessref=rgemcas\n                     incaslib=\"&_rgem_tablesCaslib.\"\n                     outcaslib=\"&_rgem_tablesCaslib.\";\n            droptable casdata=\"&table.\" quiet;\n        quit;\n        %let opts = (promote=yes);\n    %end;\n    %else %let opts = (compress=yes);\n    %if &_rgem_ninv. GT 0 %then %do;\n        filename rgemino \"%sysfunc(pathname(work))/rgem_inventory_out.json\";\n        libname rgeminj json fileref=rgemino;\n        data &_rgem_invout.&opts.;\n            length doc_id $ 40 source_uri $ 1024 source_kind $ 16\n                   content_hash $ 64 mtime $ 32 status $ 12 error_text $ 512\n                   pipeline_version $ 32 config_hash $ 32 chunk_count 8\n                   run_id $ 32 updated_at $ 24 extractor $ 64\n                   rag_project $ 20 tables_caslib $ 32;\n            label doc_id=\"Document ID\" source_uri=\"Source location\"\n                  source_kind=\"Source type\" content_hash=\"Content fingerprint\"\n                  mtime=\"Source last modified\" status=\"Ingestion status\"\n                  error_text=\"Failure reason\" pipeline_version=\"Pipeline version\"\n                  config_hash=\"Configuration fingerprint\" chunk_count=\"Chunks produced\"\n                  run_id=\"Ingestion run ID\" updated_at=\"Row updated (UTC)\"\n                  extractor=\"Text extractor used\" rag_project=\"RAG project\"\n                  tables_caslib=\"Pipeline tables caslib\";\n            set rgeminj.root(drop=ordinal_root);\n        run;\n        libname rgeminj clear;\n        filename rgemino clear;\n    %end;\n    %else %do;\n        data &_rgem_invout.&opts.;\n            length doc_id $ 40 source_uri $ 1024 source_kind $ 16\n                   content_hash $ 64 mtime $ 32 status $ 12 error_text $ 512\n                   pipeline_version $ 32 config_hash $ 32 chunk_count 8\n                   run_id $ 32 updated_at $ 24 extractor $ 64\n                   rag_project $ 20 tables_caslib $ 32;\n            label doc_id=\"Document ID\" source_uri=\"Source location\"\n                  source_kind=\"Source type\" content_hash=\"Content fingerprint\"\n                  mtime=\"Source last modified\" status=\"Ingestion status\"\n                  error_text=\"Failure reason\" pipeline_version=\"Pipeline version\"\n                  config_hash=\"Configuration fingerprint\" chunk_count=\"Chunks produced\"\n                  run_id=\"Ingestion run ID\" updated_at=\"Row updated (UTC)\"\n                  extractor=\"Text extractor used\" rag_project=\"RAG project\"\n                  tables_caslib=\"Pipeline tables caslib\";\n            call missing(of _all_);\n            stop;\n        run;\n    %end;\n%mend _rgem_emit_inventory;\n%_rgem_emit_inventory;\n\nlibname rgemout clear;\ncas rgemcas terminate;\n\ndata _null_;\n    length part $ 500;\n    if \"&_rgem_rc.\" ne \"0\" then do;\n        putLog \"ERROR: RAG - Embed Chunks failed: %superq(_rgem_error)\";\n        abort 42;\n    end;\n    putLog \"NOTE: ----- RAG - Embed Chunks -----\";\n    do i = 1 to countw(\"%superq(_rgem_summary)\", \"|\");\n        part = strip(scan(\"%superq(_rgem_summary)\", i, \"|\"));\n        if part ne \"\" then putLog \"NOTE:   \" part;\n    end;\nrun;"}, "type": "code", "ui": "{\n\t\"showPageContentOnly\": true,\n\t\"pages\": [\n\t\t{\n\t\t\t\"id\": \"pageDefinition\",\n\t\t\t\"type\": \"page\",\n\t\t\t\"label\": \"Definition\",\n\t\t\t\"children\": [\n\t\t\t\t{\n\t\t\t\t\t\"id\": \"_rgem_info\",\n\t\t\t\t\t\"type\": \"text\",\n\t\t\t\t\t\"text\": \"Embeds every chunk in <project>_CHUNKS through the SCR embedding container deployed from SAS Model Manager (default model: all_minilm_l6_v2) into <project>_EMBEDDED. Vectors already in that table for identical chunk ids are reused automatically - rerunning after an interruption only embeds what is missing.\",\n\t\t\t\t\t\"visible\": \"\"\n\t\t\t\t},\n\t\t\t\t{\n\t\t\t\t\t\"id\": \"_rgem_inventory\",\n\t\t\t\t\t\"type\": \"inputtable\",\n\t\t\t\t\t\"label\": \"Updated inventory (from RAG - Chunk Documents):\",\n\t\t\t\t\t\"required\": false,\n\t\t\t\t\t\"placeholder\": \"\",\n\t\t\t\t\t\"visible\": \"\"\n\t\t\t\t},\n\t\t\t\t{\n\t\t\t\t\t\"id\": \"_rgem_scrEndpoint\",\n\t\t\t\t\t\"type\": \"textfield\",\n\t\t\t\t\t\"label\": \"SCR base URL hosting the embedding container (blank = <viya-host>/llm):\",\n\t\t\t\t\t\"placeholder\": \"\",\n\t\t\t\t\t\"required\": false,\n\t\t\t\t\t\"visible\": \"\"\n\t\t\t\t},\n\t\t\t\t{\n\t\t\t\t\t\"id\": \"_rgem_embedModel\",\n\t\t\t\t\t\"type\": \"textfield\",\n\t\t\t\t\t\"label\": \"Embedding model name:\",\n\t\t\t\t\t\"placeholder\": \"\",\n\t\t\t\t\t\"required\": false,\n\t\t\t\t\t\"visible\": \"\"\n\t\t\t\t},\n\t\t\t\t{\n\t\t\t\t\t\"id\": \"_rgem_deploymentType\",\n\t\t\t\t\t\"type\": \"radiogroup\",\n\t\t\t\t\t\"label\": \"Container deployment type:\",\n\t\t\t\t\t\"items\": [\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"value\": \"k8s\",\n\t\t\t\t\t\t\t\"label\": \"Kubernetes (path-based routing)\"\n\t\t\t\t\t\t},\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"value\": \"aca\",\n\t\t\t\t\t\t\t\"label\": \"Azure Container Apps (host-based routing)\"\n\t\t\t\t\t\t}\n\t\t\t\t\t],\n\t\t\t\t\t\"visible\": \"\"\n\t\t\t\t},\n\t\t\t\t{\n\t\t\t\t\t\"id\": \"_rgem_sectionAdvanced\",\n\t\t\t\t\t\"type\": \"section\",\n\t\t\t\t\t\"label\": \"Runtime\",\n\t\t\t\t\t\"open\": false,\n\t\t\t\t\t\"visible\": \"\",\n\t\t\t\t\t\"children\": [\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"id\": \"_rgem_replicas\",\n\t\t\t\t\t\t\t\"type\": \"numstepper\",\n\t\t\t\t\t\t\t\"label\": \"Replicas of the embedding container (the step runs 4 parallel calls per replica):\",\n\t\t\t\t\t\t\t\"integer\": true,\n\t\t\t\t\t\t\t\"min\": 1,\n\t\t\t\t\t\t\t\"max\": null,\n\t\t\t\t\t\t\t\"stepsize\": 1,\n\t\t\t\t\t\t\t\"required\": false,\n\t\t\t\t\t\t\t\"visible\": \"\"\n\t\t\t\t\t\t},\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"id\": \"_rgem_ragCorePath\",\n\t\t\t\t\t\t\t\"type\": \"path\",\n\t\t\t\t\t\t\t\"label\": \"SAS Content folder holding rag_core (set by the deployment - not editable here):\",\n\t\t\t\t\t\t\t\"pathtype\": \"folder\",\n\t\t\t\t\t\t\t\"placeholder\": \"\",\n\t\t\t\t\t\t\t\"required\": false,\n\t\t\t\t\t\t\t\"visible\": \"\",\n\t\t\t\t\t\t\t\"enabled\": [\n\t\t\t\t\t\t\t\t\"$_rgem_ragCorePath\",\n\t\t\t\t\t\t\t\t\"=\",\n\t\t\t\t\t\t\t\t\"__set_by_deployment__\"\n\t\t\t\t\t\t\t]\n\t\t\t\t\t\t}\n\t\t\t\t\t]\n\t\t\t\t},\n\t\t\t\t{\n\t\t\t\t\t\"id\": \"_rgem_invout\",\n\t\t\t\t\t\"type\": \"outputtable\",\n\t\t\t\t\t\"label\": \"Updated inventory output (wire this one forward):\",\n\t\t\t\t\t\"required\": false,\n\t\t\t\t\t\"placeholder\": \"\",\n\t\t\t\t\t\"visible\": \"\"\n\t\t\t\t}\n\t\t\t]\n\t\t},\n\t\t{\n\t\t\t\"id\": \"pageAbout\",\n\t\t\t\"type\": \"page\",\n\t\t\t\"label\": \"About\",\n\t\t\t\"children\": [\n\t\t\t\t{\n\t\t\t\t\t\"id\": \"textAbout\",\n\t\t\t\t\t\"type\": \"text\",\n\t\t\t\t\t\"text\": \"RAG - Embed Chunks step\\n==========\\n\\nCalls the SCR embedding contract with a thread pool and retry/backoff. Per-chunk failures are logged and reported in the summary; the step only fails when nothing could be embedded at all (endpoint down). Because vectors live in the promoted <project>_EMBEDDED table, a rerun reuses every vector whose deterministic chunk id is unchanged. Interactive flows suit corpora below roughly 100k chunks - use the scheduled Ingest-Documents job above that.\\n\\nFlow wiring: chain the document INVENTORY through every step - RAG - List Documents \u2192 Extract Text \u2192 Chunk Documents \u2192 Embed Chunks \u2192 Load Vector Store. The bulk data travels beside the flow in promoted CAS tables named <project>_ELEMENTS, <project>_CHUNKS, <project>_EMBEDDED and <project>_LEDGER in the tables caslib (each saved to disk, so state survives server restarts; names stay within 32 characters so they display nicely in SAS Studio). Each step's output table lands in that same caslib as <project>_INV_LIST, _INV_EXTRACT, _INV_CHUNK, _INV_EMBED and <project>_LOAD_REPORT unless you point the output port somewhere else. Give every step the SAME project name and caslib.\",\n\t\t\t\t\t\"visible\": \"\"\n\t\t\t\t},\n\t\t\t\t{\n\t\t\t\t\t\"id\": \"sectionPrereqs\",\n\t\t\t\t\t\"type\": \"section\",\n\t\t\t\t\t\"label\": \"Pre-requisites\",\n\t\t\t\t\t\"open\": false,\n\t\t\t\t\t\"visible\": \"\",\n\t\t\t\t\t\"children\": [\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"id\": \"textPrereqs\",\n\t\t\t\t\t\t\t\"type\": \"text\",\n\t\t\t\t\t\t\t\"text\": \"Tested on SAS Viya 2026 (Stable).\\n\\n* The rag_core runtime must be deployed to SAS Content (default: /SAS Agentic AI Accelerator/RAG/rag_core) with deploy-rag-content.ps1/.sh - keep that folder read-only for regular users.\\n* The compute context's Python needs the requests, swat and pandas packages (swat/pandas carry the pipeline tables to CAS - varchar columns, no 32k limit).\\n* CAS available; the runner needs write access to the tables caslib.\\n* A deployed SCR embedding container (see the model definition for all_minilm_l6_v2 in LLM-Definitions).\",\n\t\t\t\t\t\t\t\"visible\": \"\"\n\t\t\t\t\t\t}\n\t\t\t\t\t]\n\t\t\t\t},\n\t\t\t\t{\n\t\t\t\t\t\"id\": \"sectionChangelog\",\n\t\t\t\t\t\"type\": \"section\",\n\t\t\t\t\t\"label\": \"Changelog\",\n\t\t\t\t\t\"open\": true,\n\t\t\t\t\t\"visible\": \"\",\n\t\t\t\t\t\"children\": [\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"id\": \"textChangelog\",\n\t\t\t\t\t\t\t\"type\": \"text\",\n\t\t\t\t\t\t\t\"text\": \"* Version: 1.2 (29JUL2026)\\n      - SAS Content document sources; output tables land in the tables caslib; labelled columns; numeric and list-of-values fields; run summary in the log\\n* Version: 1.1 (28JUL2026)\\n      - Pipeline tables move to promoted CAS tables via SWAT (varchar, no 32k limit); automatic embed checkpoint\\n* Version: 1.0 (28JUL2026)\\n      - Initial version\",\n\t\t\t\t\t\t\t\"visible\": \"\"\n\t\t\t\t\t\t}\n\t\t\t\t\t]\n\t\t\t\t}\n\t\t\t]\n\t\t}\n\t],\n\t\"syntaxversion\": \"1.3.0\",\n\t\"values\": {\n\t\t\"_rgem_ragCorePath\": \"/SAS Agentic AI Accelerator/RAG/rag_core\",\n\t\t\"_rgem_scrEndpoint\": \"\",\n\t\t\"_rgem_embedModel\": \"all_minilm_l6_v2\",\n\t\t\"_rgem_deploymentType\": {\n\t\t\t\"value\": \"k8s\",\n\t\t\t\"label\": \"Kubernetes (path-based routing)\"\n\t\t},\n\t\t\"_rgem_replicas\": 1\n\t}\n}"}