{"name": "RAG - Load Vector Store.step", "displayName": "RAG - Load Vector Store.step", "localDisplayName": "RAG - Load Vector Store.step", "description": "Loads embedded RAG chunks into the vector store (upsert-first-then-delete-stale), updates the CAS ingestion ledger and outputs a per-document load report; credentials come from the SAS Viya credential domain.", "localDescription": "Loads embedded RAG chunks into the vector store (upsert-first-then-delete-stale), updates the CAS ingestion ledger and outputs a per-document load report; credentials come from the SAS Viya credential domain.", "properties": {}, "metadataVersion": 0.0, "version": 2, "type": "code", "flowMetadata": {"inputPorts": [{"name": "_rgld_embedded", "displayName": "_rgld_embedded", "localDisplayName": "_rgld_embedded", "minEntries": 0, "maxEntries": 1, "defaultEntries": 0, "type": "table"}, {"name": "_rgld_inventory", "displayName": "_rgld_inventory", "localDisplayName": "_rgld_inventory", "minEntries": 0, "maxEntries": 1, "defaultEntries": 0, "type": "table"}], "outputPorts": [{"name": "_rgld_report", "displayName": "_rgld_report", "localDisplayName": "_rgld_report", "minEntries": 0, "maxEntries": 1, "defaultEntries": 0, "type": "table"}]}, "ui": "{\n\t\"showPageContentOnly\": true,\n\t\"pages\": [\n\t\t{\n\t\t\t\"id\": \"pageDefinition\",\n\t\t\t\"type\": \"page\",\n\t\t\t\"label\": \"Definition\",\n\t\t\t\"children\": [\n\t\t\t\t{\n\t\t\t\t\t\"id\": \"_rgld_info\",\n\t\t\t\t\t\"type\": \"text\",\n\t\t\t\t\t\"text\": \"Loads embedded chunks into the vector store and finalizes the run: new chunks are upserted FIRST, stale ones deleted after (a crash never leaves a document unretrievable), then the ingestion ledger is updated in CAS. Vector store credentials are resolved from the credential domain as {backend}_user / {backend}_password - secrets never appear in the flow.\",\n\t\t\t\t\t\"visible\": \"\"\n\t\t\t\t},\n\t\t\t\t{\n\t\t\t\t\t\"id\": \"_rgld_embedded\",\n\t\t\t\t\t\"type\": \"inputtable\",\n\t\t\t\t\t\"label\": \"Embedded chunks (from RAG - Embed Chunks):\",\n\t\t\t\t\t\"required\": false,\n\t\t\t\t\t\"placeholder\": \"\",\n\t\t\t\t\t\"visible\": \"\"\n\t\t\t\t},\n\t\t\t\t{\n\t\t\t\t\t\"id\": \"_rgld_inventory\",\n\t\t\t\t\t\"type\": \"inputtable\",\n\t\t\t\t\t\"label\": \"Updated inventory (from RAG - Chunk Documents):\",\n\t\t\t\t\t\"required\": false,\n\t\t\t\t\t\"placeholder\": \"\",\n\t\t\t\t\t\"visible\": \"\"\n\t\t\t\t},\n\t\t\t\t{\n\t\t\t\t\t\"id\": \"_rgld_collection\",\n\t\t\t\t\t\"type\": \"textfield\",\n\t\t\t\t\t\"label\": \"Collection (lowercase identifier, e.g. rag_hr_policies_v1):\",\n\t\t\t\t\t\"placeholder\": \"\",\n\t\t\t\t\t\"required\": true,\n\t\t\t\t\t\"visible\": \"\"\n\t\t\t\t},\n\t\t\t\t{\n\t\t\t\t\t\"id\": \"_rgld_storeHost\",\n\t\t\t\t\t\"type\": \"textfield\",\n\t\t\t\t\t\"label\": \"Vector store host:\",\n\t\t\t\t\t\"placeholder\": \"\",\n\t\t\t\t\t\"required\": true,\n\t\t\t\t\t\"visible\": \"\"\n\t\t\t\t},\n\t\t\t\t{\n\t\t\t\t\t\"id\": \"_rgld_storePort\",\n\t\t\t\t\t\"type\": \"textfield\",\n\t\t\t\t\t\"label\": \"Vector store port:\",\n\t\t\t\t\t\"placeholder\": \"\",\n\t\t\t\t\t\"required\": false,\n\t\t\t\t\t\"visible\": \"\"\n\t\t\t\t},\n\t\t\t\t{\n\t\t\t\t\t\"id\": \"_rgld_storeDb\",\n\t\t\t\t\t\"type\": \"textfield\",\n\t\t\t\t\t\"label\": \"Database name:\",\n\t\t\t\t\t\"placeholder\": \"\",\n\t\t\t\t\t\"required\": true,\n\t\t\t\t\t\"visible\": \"\"\n\t\t\t\t},\n\t\t\t\t{\n\t\t\t\t\t\"id\": \"_rgld_sectionAdvanced\",\n\t\t\t\t\t\"type\": \"section\",\n\t\t\t\t\t\"label\": \"Runtime\",\n\t\t\t\t\t\"open\": false,\n\t\t\t\t\t\"visible\": \"\",\n\t\t\t\t\t\"children\": [\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"id\": \"_rgld_backend\",\n\t\t\t\t\t\t\t\"type\": \"textfield\",\n\t\t\t\t\t\t\t\"label\": \"Backend adapter:\",\n\t\t\t\t\t\t\t\"placeholder\": \"\",\n\t\t\t\t\t\t\t\"required\": false,\n\t\t\t\t\t\t\t\"visible\": \"\"\n\t\t\t\t\t\t},\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"id\": \"_rgld_storeSslmode\",\n\t\t\t\t\t\t\t\"type\": \"textfield\",\n\t\t\t\t\t\t\t\"label\": \"SSL mode:\",\n\t\t\t\t\t\t\t\"placeholder\": \"\",\n\t\t\t\t\t\t\t\"required\": false,\n\t\t\t\t\t\t\t\"visible\": \"\"\n\t\t\t\t\t\t},\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"id\": \"_rgld_credentialDomain\",\n\t\t\t\t\t\t\t\"type\": \"textfield\",\n\t\t\t\t\t\t\t\"label\": \"Credential domain:\",\n\t\t\t\t\t\t\t\"placeholder\": \"\",\n\t\t\t\t\t\t\t\"required\": false,\n\t\t\t\t\t\t\t\"visible\": \"\"\n\t\t\t\t\t\t},\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"id\": \"_rgld_embeddingDims\",\n\t\t\t\t\t\t\t\"type\": \"textfield\",\n\t\t\t\t\t\t\t\"label\": \"Embedding dimensions (blank = derived from the data; only used when creating an empty collection):\",\n\t\t\t\t\t\t\t\"placeholder\": \"\",\n\t\t\t\t\t\t\t\"required\": false,\n\t\t\t\t\t\t\t\"visible\": \"\"\n\t\t\t\t\t\t},\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"id\": \"_rgld_configHash\",\n\t\t\t\t\t\t\t\"type\": \"textfield\",\n\t\t\t\t\t\t\t\"label\": \"Config hash stamped into the ledger (blank = keep values from the inventory):\",\n\t\t\t\t\t\t\t\"placeholder\": \"\",\n\t\t\t\t\t\t\t\"required\": false,\n\t\t\t\t\t\t\t\"visible\": \"\"\n\t\t\t\t\t\t},\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"id\": \"_rgld_ledgerCaslib\",\n\t\t\t\t\t\t\t\"type\": \"textfield\",\n\t\t\t\t\t\t\t\"label\": \"Ledger caslib:\",\n\t\t\t\t\t\t\t\"placeholder\": \"\",\n\t\t\t\t\t\t\t\"required\": false,\n\t\t\t\t\t\t\t\"visible\": \"\"\n\t\t\t\t\t\t},\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"id\": \"_rgld_ledgerTable\",\n\t\t\t\t\t\t\t\"type\": \"textfield\",\n\t\t\t\t\t\t\t\"label\": \"Ledger table:\",\n\t\t\t\t\t\t\t\"placeholder\": \"\",\n\t\t\t\t\t\t\t\"required\": false,\n\t\t\t\t\t\t\t\"visible\": \"\"\n\t\t\t\t\t\t},\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"id\": \"_rgld_ragCorePath\",\n\t\t\t\t\t\t\t\"type\": \"textfield\",\n\t\t\t\t\t\t\t\"label\": \"SAS Content folder holding rag_core:\",\n\t\t\t\t\t\t\t\"placeholder\": \"\",\n\t\t\t\t\t\t\t\"required\": false,\n\t\t\t\t\t\t\t\"visible\": \"\"\n\t\t\t\t\t\t}\n\t\t\t\t\t]\n\t\t\t\t},\n\t\t\t\t{\n\t\t\t\t\t\"id\": \"_rgld_report\",\n\t\t\t\t\t\"type\": \"outputtable\",\n\t\t\t\t\t\"label\": \"Per-document load report output:\",\n\t\t\t\t\t\"required\": false,\n\t\t\t\t\t\"placeholder\": \"\",\n\t\t\t\t\t\"visible\": \"\"\n\t\t\t\t}\n\t\t\t]\n\t\t},\n\t\t{\n\t\t\t\"id\": \"pageAbout\",\n\t\t\t\"type\": \"page\",\n\t\t\t\"label\": \"About\",\n\t\t\t\"children\": [\n\t\t\t\t{\n\t\t\t\t\t\"id\": \"textAbout\",\n\t\t\t\t\t\"type\": \"text\",\n\t\t\t\t\t\"text\": \"RAG - Load Vector Store step\\n==========\\n\\nTerminates the RAG ingestion flow: per-document upsert-then-delete-stale into the vector store (P1 backend: pgvector), tombstoning of deleted documents, then the merged ledger is promoted AND saved in CAS so incremental ingestion survives server restarts. The report output shows every document's final status.\\n\\nFlow wiring: RAG - List Documents \u2192 RAG - Extract Text (inventory) \u2192 RAG - Chunk Documents (elements + updated inventory) \u2192 RAG - Embed Chunks (chunks) \u2192 RAG - Load Vector Store (embedded chunks + updated inventory). Always pass each step's UPDATED inventory forward so per-document failures and chunk counts reach the ledger.\",\n\t\t\t\t\t\"visible\": \"\"\n\t\t\t\t},\n\t\t\t\t{\n\t\t\t\t\t\"id\": \"sectionPrereqs\",\n\t\t\t\t\t\"type\": \"section\",\n\t\t\t\t\t\"label\": \"Pre-requisites\",\n\t\t\t\t\t\"open\": false,\n\t\t\t\t\t\"visible\": \"\",\n\t\t\t\t\t\"children\": [\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"id\": \"textPrereqs\",\n\t\t\t\t\t\t\t\"type\": \"text\",\n\t\t\t\t\t\t\t\"text\": \"Tested on SAS Viya 2026 (Stable).\\n\\n* The rag_core runtime must be deployed to SAS Content (default: /SAS Agentic AI Accelerator/RAG/rag_core) with deploy-rag-content.ps1/.sh - keep that folder read-only for regular users.\\n* The compute context's Python needs the requests package.\\n* psycopg2-binary for the pgvector backend.\\n* CAS, for the ingestion ledger.\\n* A credential domain (default agentic-ai-keys) holding {backend}_user/{backend}_password - see the Managing Credentials guide in the Administration documentation.\",\n\t\t\t\t\t\t\t\"visible\": \"\"\n\t\t\t\t\t\t}\n\t\t\t\t\t]\n\t\t\t\t},\n\t\t\t\t{\n\t\t\t\t\t\"id\": \"sectionDocumentation\",\n\t\t\t\t\t\"type\": \"section\",\n\t\t\t\t\t\"label\": \"Documentation\",\n\t\t\t\t\t\"open\": false,\n\t\t\t\t\t\"visible\": \"\",\n\t\t\t\t\t\"children\": [\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"id\": \"textDocumentation\",\n\t\t\t\t\t\t\t\"type\": \"text\",\n\t\t\t\t\t\t\t\"text\": \"Do not run this flow while the scheduled Ingest-Documents job is active on the same ledger - the step refuses when it sees a fresh run lock.\",\n\t\t\t\t\t\t\t\"visible\": \"\"\n\t\t\t\t\t\t}\n\t\t\t\t\t]\n\t\t\t\t},\n\t\t\t\t{\n\t\t\t\t\t\"id\": \"sectionChangelog\",\n\t\t\t\t\t\"type\": \"section\",\n\t\t\t\t\t\"label\": \"Changelog\",\n\t\t\t\t\t\"open\": true,\n\t\t\t\t\t\"visible\": \"\",\n\t\t\t\t\t\"children\": [\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"id\": \"textChangelog\",\n\t\t\t\t\t\t\t\"type\": \"text\",\n\t\t\t\t\t\t\t\"text\": \"* Version: 1.0 (28JUL2026)\\n      - Initial version\",\n\t\t\t\t\t\t\t\"visible\": \"\"\n\t\t\t\t\t\t}\n\t\t\t\t\t]\n\t\t\t\t}\n\t\t\t]\n\t\t}\n\t],\n\t\"syntaxversion\": \"1.3.0\",\n\t\"values\": {\n\t\t\"_rgld_collection\": \"\",\n\t\t\"_rgld_storeHost\": \"\",\n\t\t\"_rgld_storePort\": \"5432\",\n\t\t\"_rgld_storeDb\": \"\",\n\t\t\"_rgld_backend\": \"pgvector\",\n\t\t\"_rgld_storeSslmode\": \"prefer\",\n\t\t\"_rgld_credentialDomain\": \"agentic-ai-keys\",\n\t\t\"_rgld_embeddingDims\": \"\",\n\t\t\"_rgld_configHash\": \"\",\n\t\t\"_rgld_ledgerCaslib\": \"casuser\",\n\t\t\"_rgld_ledgerTable\": \"RAG_INGESTION_LEDGER\",\n\t\t\"_rgld_ragCorePath\": \"/SAS Agentic AI Accelerator/RAG/rag_core\"\n\t}\n}", "templates": {"SAS": "/******************************************************************************\n * Copyright \u00a9 2026, SAS Institute Inc., Cary, NC, USA.  All Rights Reserved.\n * SPDX-License-Identifier: Apache-2.0\n *\n * RAG - Load Vector Store: load embedded chunks into the vector store with\n * upsert-first-then-delete-stale ordering (a crash never leaves a document\n * unretrievable), update the incremental-ingestion ledger in CAS (promote +\n * save) and output a per-document load report. Store credentials come from\n * the SAS Viya credential domain - never from the flow.\n * Thin shell over rag_core.steps.run_load - see the About tab.\n ******************************************************************************/\n%macro _rgld_setup;\n    %if not %symexist(_rgld_report) %then %global _rgld_report;\n    %if %length(%superq(_rgld_report)) EQ 0 %then %let _rgld_report = WORK.RAG_LOAD_REPORT;\n    %if not %symexist(_rgld_ledgerCaslib) %then %global _rgld_ledgerCaslib;\n    %if %length(%superq(_rgld_ledgerCaslib)) EQ 0 %then %let _rgld_ledgerCaslib = casuser;\n    %if not %symexist(_rgld_ledgerTable) %then %global _rgld_ledgerTable;\n    %if %length(%superq(_rgld_ledgerTable)) EQ 0 %then %let _rgld_ledgerTable = RAG_INGESTION_LEDGER;\n%mend _rgld_setup;\n%_rgld_setup;\n\n%let _rgld_viyaHost = %sysfunc(getoption(SERVICESBASEURL));\n%let _rgld_rc = 1;\n%let _rgld_error = The Python program did not run.;\n%let _rgld_summary = ;\n%let _rgld_nledger = 0;\n%let _rgld_nreport = 0;\n\n%macro _rgld_export(portvar, file);\n    %if %symexist(&portvar.) %then %do;\n        %if %length(%superq(&&portvar.)) GT 0 %then %do;\n            %if %sysfunc(exist(&&&portvar..)) %then %do;\n                filename _rgld_io \"%sysfunc(pathname(work))/&file.\";\n                proc json out=_rgld_io noSASTags;\n                    export &&&portvar..;\n                run; quit;\n                filename _rgld_io clear;\n            %end;\n        %end;\n    %end;\n%mend _rgld_export;\n%_rgld_export(_rgld_embedded, rgld_embedded_in.json);\n%_rgld_export(_rgld_inventory, rgld_inventory_in.json);\n\n/* Read-only ledger snapshot (the run lock is the scheduled job's\n   discipline; this step only refuses to run beside a fresh lock). */\n%macro _rgld_ledger_export;\n    cas rgldcas;\n    libname rgldcl cas caslib=\"&_rgld_ledgerCaslib.\" sessref=rgldcas;\n    %if %sysfunc(exist(rgldcl.&_rgld_ledgerTable.)) %then %do;\n        filename rgldled \"%sysfunc(pathname(work))/rgld_ledger_in.json\";\n        proc json out=rgldled noSASTags;\n            export rgldcl.&_rgld_ledgerTable.;\n        run; quit;\n        filename rgldled clear;\n    %end;\n    libname rgldcl clear;\n    cas rgldcas terminate;\n%mend _rgld_ledger_export;\n%_rgld_ledger_export;\n\nproc python restart;\nsubmit;\ndef main():\n    import json\n    import os\n    import sys\n    import tempfile\n    import time\n    import traceback\n\n    def sas_safe(text):\n        \"\"\"Strings crossing into SAS.logMessage/SAS.symput are embedded into\n        generated SAS statements - quotes and macro characters corrupt the\n        code stream (verified live). EVERY such string goes through here.\"\"\"\n        cleaned = str(text)\n        for ch in (\"'\", '\"', \"%\", \"&\", \";\"):\n            cleaned = cleaned.replace(ch, \" \")\n        return cleaned\n\n    def M(msg):\n        SAS.logMessage(\"RAGLOAD \" + sas_safe(msg))\n\n    try:\n        import requests\n    except Exception:\n        SAS.symput(\"_rgld_error\", \"The Python environment of this compute \"\n                                   \"context lacks the requests package - see \"\n                                   \"the RAG administration guide.\")\n        return\n\n    BASE = str(SAS.symget(\"_rgld_viyaHost\") or \"\").rstrip(\"/\")\n    TOKEN = os.environ.get(\"SAS_SERVICES_TOKEN\", \"\")\n    AUTH = {\"Authorization\": \"Bearer \" + TOKEN}\n    VERIFY = os.environ.get(\"SSLCALISTLOC\") or os.environ.get(\"CAS_CLIENT_SSL_CA_LIST\") or True\n    WORKPATH = SAS.workpath if SAS.workpath.endswith(os.sep) else SAS.workpath + os.sep\n\n    P = {name: str(SAS.symget(name) or \"\").strip() for name in [\n        \"_rgld_backend\",\n        \"_rgld_collection\",\n        \"_rgld_storeHost\",\n        \"_rgld_storePort\",\n        \"_rgld_storeDb\",\n        \"_rgld_storeSslmode\",\n        \"_rgld_credentialDomain\",\n        \"_rgld_embeddingDims\",\n        \"_rgld_configHash\",\n        \"_rgld_ragCorePath\",\n    ]}\n\n    def read_rows(filename, missing_message):\n        path = WORKPATH + filename\n        if not os.path.exists(path):\n            raise RuntimeError(missing_message)\n        with open(path, \"r\", encoding=\"utf-8\") as fh:\n            data = json.load(fh)\n        rows = []\n        for row in data if isinstance(data, list) else []:\n            rows.append({str(k).lower(): v for k, v in row.items()})\n        return rows\n\n    def write_rows(filename, rows, columns, numeric=()):\n        out = []\n        for row in rows:\n            rec = {}\n            for column in columns:\n                value = row.get(column)\n                if column in numeric:\n                    try:\n                        rec[column] = float(value or 0)\n                    except Exception:\n                        rec[column] = 0.0\n                else:\n                    rec[column] = \"\" if value is None else str(value)\n            out.append(rec)\n        with open(WORKPATH + filename, \"w\", encoding=\"utf-8\") as fh:\n            json.dump(out, fh)\n        return len(out)\n\n    try:\n        # ---- rag_core bootstrap: download the governed SAS Content folder --\n        def get_json(endpoint, **params):\n            response = requests.get(BASE + endpoint, params=params, headers=AUTH,\n                                    verify=VERIFY, timeout=(5, 30))\n            response.raise_for_status()\n            return response.json()\n\n        def download_folder(folder_id, local_dir):\n            os.makedirs(local_dir, exist_ok=True)\n            count = 0\n            members = get_json(f\"/folders/folders/{folder_id}/members\", limit=200)\n            for member in members.get(\"items\", []):\n                uri = member.get(\"uri\", \"\")\n                if \"/files/files/\" in uri:\n                    content = requests.get(BASE + uri + \"/content\", headers=AUTH,\n                                           verify=VERIFY, timeout=(5, 60))\n                    content.raise_for_status()\n                    with open(os.path.join(local_dir, member[\"name\"]), \"wb\") as fh:\n                        fh.write(content.content)\n                    count += 1\n                elif \"/folders/folders/\" in uri:\n                    count += download_folder(uri.rsplit(\"/\", 1)[-1],\n                                             os.path.join(local_dir, member[\"name\"]))\n            return count\n\n        core_path = P[\"_rgld_ragCorePath\"] or \"/SAS Agentic AI Accelerator/RAG/rag_core\"\n        root = requests.get(BASE + \"/folders/folders/@item\",\n                            params={\"path\": core_path}, headers=AUTH,\n                            verify=VERIFY, timeout=(5, 30))\n        if root.status_code != 200:\n            raise RuntimeError(f\"rag_core folder {core_path} not found \"\n                               f\"(HTTP {root.status_code}) - deploy it per the \"\n                               \"administration guide\")\n        staging = tempfile.mkdtemp(prefix=\"rag_core_\")\n        n_files = download_folder(root.json()[\"id\"], os.path.join(staging, \"rag_core\"))\n        sys.path.insert(0, staging)\n        import rag_core\n        M(f\"rag_core {rag_core.RAG_CORE_VERSION} bootstrapped ({n_files} files)\")\n\n        def chunk_to_row(chunk):\n            row = dict(chunk)\n            for column in (\"span\", \"tags\", \"entities\", \"relations\", \"embedding\"):\n                value = chunk.get(column)\n                row[column] = json.dumps(value) if value not in (None, \"\", {}) else \"\"\n            return row\n\n        def row_to_chunk(row):\n            chunk = dict(row)\n            chunk[\"chunk_index\"] = int(float(row.get(\"chunk_index\") or 0))\n            for column in (\"span\", \"entities\", \"relations\", \"embedding\"):\n                chunk[column] = json.loads(row[column]) if row.get(column) else None\n            chunk[\"tags\"] = json.loads(row[\"tags\"]) if row.get(\"tags\") else {}\n            for column in (\"heading_path\", \"prev_id\", \"next_id\", \"context_header\"):\n                chunk[column] = row.get(column) or None\n            return chunk\n\n        from rag_core.adapters import get_adapter\n        from rag_core.credentials import fetch_secrets, store_config_from_secrets\n        from rag_core.steps import LEDGER_COLUMNS, merge_ledger, run_load\n\n        inventory_columns = LEDGER_COLUMNS + [\"extractor\"]\n        missing = [name for name in (\"collection\", \"storeHost\", \"storeDb\")\n                   if not P[\"_rgld_\" + name]]\n        if missing:\n            raise RuntimeError(\"required parameters missing: \"\n                               + \", \".join(missing))\n\n        embedded = []\n        for row in read_rows(\"rgld_embedded_in.json\",\n                             \"the embedded-chunks input port is not \"\n                             \"connected - wire the RAG - Embed Chunks \"\n                             \"output into this step\"):\n            chunk = row_to_chunk(row)\n            if chunk.get(\"embedding\"):\n                embedded.append(chunk)\n        inventory = read_rows(\"rgld_inventory_in.json\",\n                              \"the inventory input port is not connected - \"\n                              \"wire the RAG - Chunk Documents \"\n                              \"updated-inventory output into this step\")\n\n        ledger = []\n        if os.path.exists(WORKPATH + \"rgld_ledger_in.json\"):\n            for row in read_rows(\"rgld_ledger_in.json\", \"unreachable\"):\n                ledger.append({column: row.get(column, \"\")\n                               for column in LEDGER_COLUMNS})\n        real_rows = [r for r in ledger if r.get(\"doc_id\") != \"__run_lock__\"]\n        lock_rows = [r for r in ledger if r.get(\"doc_id\") == \"__run_lock__\"]\n        if lock_rows:\n            try:\n                held_for = time.time() - float(lock_rows[0].get(\"mtime\") or 0)\n            except Exception:\n                held_for = 1e9\n            if held_for < 1800:\n                raise RuntimeError(\"a scheduled ingestion run appears active on \"\n                                   \"this ledger (run lock held) - retry later\")\n            M(\"stale run lock ignored (held longer than 30 minutes)\")\n\n        domain = P[\"_rgld_credentialDomain\"] or \"agentic-ai-keys\"\n        secrets = fetch_secrets(BASE, TOKEN, domain, verify=VERIFY)\n        if not secrets:\n            raise RuntimeError(\"no credential resolved from domain \" + domain\n                               + \" for this user - see the Managing \"\n                               \"Credentials administration guide\")\n        backend = P[\"_rgld_backend\"] or \"pgvector\"\n        store_config = store_config_from_secrets(secrets, backend,\n                                                 P[\"_rgld_storeHost\"],\n                                                 P[\"_rgld_storePort\"] or 5432,\n                                                 P[\"_rgld_storeDb\"],\n                                                 P[\"_rgld_storeSslmode\"] or \"prefer\")\n        adapter = get_adapter(backend)\n        adapter.connect(store_config)\n\n        dims = 0\n        for chunk in embedded:\n            dims = len(chunk[\"embedding\"])\n            break\n        if not dims:\n            dims = int(float(P[\"_rgld_embeddingDims\"] or 384))\n        pipeline_version = \"v1\"\n        for row in inventory:\n            if row.get(\"pipeline_version\"):\n                pipeline_version = row[\"pipeline_version\"]\n                break\n\n        collection = P[\"_rgld_collection\"]\n        updated = run_load(embedded, inventory, adapter, collection,\n                           dims, pipeline_version, log=M)\n        total = adapter.count(collection)\n        adapter.close()\n\n        new_ledger = merge_ledger(real_rows, updated)\n        if P[\"_rgld_configHash\"]:\n            for row in new_ledger:\n                row[\"config_hash\"] = P[\"_rgld_configHash\"]\n        n_ledger = write_rows(\"rgld_ledger_out.json\", new_ledger,\n                              LEDGER_COLUMNS, numeric=(\"chunk_count\",))\n        n_report = write_rows(\"rgld_report_out.json\", updated,\n                              inventory_columns, numeric=(\"chunk_count\",))\n        SAS.symput(\"_rgld_nledger\", str(n_ledger))\n        SAS.symput(\"_rgld_nreport\", str(n_report))\n        statuses = {}\n        for row in updated:\n            statuses[row[\"status\"]] = statuses.get(row[\"status\"], 0) + 1\n        status_text = \", \".join(k + \"=\" + str(v)\n                                for k, v in sorted(statuses.items()))\n        summary = (f\"collection {collection}: {total} chunks; documents \"\n                   + status_text)\n        M(summary)\n        SAS.symput(\"_rgld_summary\", sas_safe(summary)[:400])\n\n        SAS.symput(\"_rgld_rc\", \"0\")\n    except Exception as error:\n        error_text = f\"{type(error).__name__}: {error}\"\n        M(\"failed: \" + sas_safe(error_text))\n        print(traceback.format_exc())\n        SAS.symput(\"_rgld_error\", sas_safe(error_text)[:500])\n\n\nmain()\nendsubmit;\nrun; quit;\nproc python terminate;\nrun; quit;\n\n/* Persist the updated ledger (promote AND save - survives restarts) */\n%macro _rgld_store_ledger;\n    %if &_rgld_rc. NE 0 %then %return;\n    %if &_rgld_nledger. LE 0 %then %return;\n    %if not %sysfunc(fileexist(%sysfunc(pathname(work))/rgld_ledger_out.json))\n        %then %return;\n    filename _rgldou \"%sysfunc(pathname(work))/rgld_ledger_out.json\";\n    libname _rgldjs json fileref=_rgldou;\n    data work._rgld_ledger_new;\n        length doc_id $ 40 source_uri $ 1024 source_kind $ 16\n                   content_hash $ 64 mtime $ 32 status $ 12 error_text $ 512\n                   pipeline_version $ 32 config_hash $ 32 chunk_count 8\n                   run_id $ 32 updated_at $ 24;\n        set _rgldjs.root(drop=ordinal_root);\n    run;\n    libname _rgldjs clear;\n    filename _rgldou clear;\n\n    cas _rgldcas;\n    proc casutil sessref=_rgldcas incaslib=\"&_rgld_ledgerCaslib.\"\n                 outcaslib=\"&_rgld_ledgerCaslib.\";\n        droptable casdata=\"&_rgld_ledgerTable.\" quiet;\n        load data=work._rgld_ledger_new casout=\"&_rgld_ledgerTable.\";\n        promote casdata=\"&_rgld_ledgerTable.\" casout=\"&_rgld_ledgerTable.\";\n        save casdata=\"&_rgld_ledgerTable.\" casout=\"&_rgld_ledgerTable.\" replace;\n    quit;\n    cas _rgldcas terminate;\n    proc datasets library=work noList;\n        delete _rgld_ledger_new;\n    run; quit;\n%mend _rgld_store_ledger;\n%_rgld_store_ledger;\n\n%macro _rgld_emit_report;\n    %if &_rgld_rc. NE 0 %then %return;\n    %if &_rgld_nreport. GT 0 %then %do;\n        filename rgldreo \"%sysfunc(pathname(work))/rgld_report_out.json\";\n        libname rgldrej json fileref=rgldreo;\n        data &_rgld_report.(compress=yes);\n            length doc_id $ 40 source_uri $ 1024 source_kind $ 16\n                   content_hash $ 64 mtime $ 32 status $ 12 error_text $ 512\n                   pipeline_version $ 32 config_hash $ 32 chunk_count 8\n                   run_id $ 32 updated_at $ 24 extractor $ 64;\n            set rgldrej.root(drop=ordinal_root);\n        run;\n        libname rgldrej clear;\n        filename rgldreo clear;\n    %end;\n    %else %do;\n        data &_rgld_report.(compress=yes);\n            length doc_id $ 40 source_uri $ 1024 source_kind $ 16\n                   content_hash $ 64 mtime $ 32 status $ 12 error_text $ 512\n                   pipeline_version $ 32 config_hash $ 32 chunk_count 8\n                   run_id $ 32 updated_at $ 24 extractor $ 64;\n            call missing(of _all_);\n            stop;\n        run;\n    %end;\n%mend _rgld_emit_report;\n%_rgld_emit_report;\n\ndata _null_;\n    if \"&_rgld_rc.\" ne \"0\" then do;\n        putLog \"ERROR: RAG - Load Vector Store failed: %superq(_rgld_error)\";\n        abort 42;\n    end;\n    putLog \"NOTE: RAG - Load Vector Store: %superq(_rgld_summary)\";\nrun;"}}