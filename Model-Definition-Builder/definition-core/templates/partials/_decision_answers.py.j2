def _headline(answer):
    # The first question's answer as a branch node reads it: the chosen
    # option, the score, or yes/no for a noul - with the confidence beside it.
    kind = answer.get("type")
    if kind == "noul":
        probability = float(answer.get("noul", 0.0))
        return ("yes" if probability >= 0.5 else "no"), (probability if probability >= 0.5 else 1.0 - probability)
    if kind == "score":
        return str(answer.get("score", "")), float(answer.get("confidence", 0.0))
    return str(answer.get("choice", "")), float(answer.get("confidence", 0.0))


def _first_answer(answers, questions):
    # The answer to the first question as the caller asked it - a provider may
    # return the answers in another order (Gemini Decision 1 does).
    if not isinstance(answers, dict):
        return {}
    first = next(iter(questions), None) if isinstance(questions, dict) else None
    return answers.get(first) or next(iter(answers.values()), {})