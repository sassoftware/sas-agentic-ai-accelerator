    }
    options = {**optionsDefaults, **_parse_options(options)}
    if options.get('Embedding_Mode') == 'document':
        embeddingObject = model.encode_document(document)
    else:
        embeddingObject = model.encode_query(document)
    embedding = json.dumps(embeddingObject.tolist())
    tokens = model.preprocess([document])['input_ids'].size(dim=1) - model.tokenizer.num_special_tokens_to_add()
    run_time = time.time() - started_timestamp
    # Logging the response
    logger.info(f"project: {project}")
    logger.info(f"tokens: {tokens}")
    logger.info(f"run_time: {run_time}")
    return embedding, run_time, tokens