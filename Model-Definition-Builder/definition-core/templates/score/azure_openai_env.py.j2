# Azure OpenAI / Azure AI Foundry, configured by the container's ENVIRONMENT.
#
# Nothing that binds this model to one subscription is a scoring input. On top
# of the connection variables every Azure definition reads (further down), this
# one also takes the key and the deployment name from the environment:
#
#   AZURE_OPENAI_API_KEY     the key - never baked into this file, and not a
#                            required scoring input (no API_KEY option). A caller
#                            that passes API_KEY anyway still wins, so a
#                            credential-domain caller keeps working unchanged.
#   AZURE_OPENAI_DEPLOYMENT  the deployment name - what Azure calls the model;
#                            blank uses the default below
#
# so ONE published image serves any Azure deployment: re-point a container by
# changing its environment, with no regeneration, rebuild or re-publish. A
# missing value fails with the variable named, rather than as an opaque 401/404.
API_KEY_ENV = 'AZURE_OPENAI_API_KEY'
DEPLOYMENT_ENV = 'AZURE_OPENAI_DEPLOYMENT'
defaultDeploymentName = '{{ deployment_name }}'

