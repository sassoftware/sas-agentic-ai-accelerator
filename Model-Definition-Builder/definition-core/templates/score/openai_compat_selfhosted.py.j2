# Self-hosted OpenAI-compatible server (Ollama, vLLM, or any endpoint that
# speaks the Chat Completions wire format). The base URL is the
# {{ base_url_env }} environment variable of the container, else the default
# baked into this file - so one published image can point at different
# inference servers without a rebuild. It is no scoring option: where the
# container sends its requests is a property of the deployment, not of a call.
# An optional bearer token is read from the {{ token_env }} environment
# variable (leave it unset for an open server).
modelVersion = '{{ model_version }}'

# Initiate the logger to write output information to the log
