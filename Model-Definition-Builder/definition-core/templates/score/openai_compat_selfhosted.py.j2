def scoreModel(userPrompt, systemPrompt, options):
    "Output: response, run_time, prompt_length, output_length"
    started_timestamp = time.time()
    # One value per input, whatever the caller's convention: CAS/SCR pass
    # one-element lists, the MAS REST API passes plain strings - and a str
    # indexed with [0] silently becomes its first character.
    userPrompt, systemPrompt = _scalar(userPrompt), _scalar(systemPrompt)
    optionsDefaults = {
{{ options_defaults_block }}
    }
    options = {**optionsDefaults, **_parse_options(options)}
    # An empty variable counts as unset, like a missing one.
    baseUrl = os.environ.get("{{ base_url_env }}") or "{{ base_url_default }}"
    modelEndpoint = baseUrl.rstrip('/') + '/chat/completions'
    headers = {"Content-Type": "application/json"}
    api_token = os.environ.get("{{ token_env }}", "")
    if api_token:
        headers["Authorization"] = f"Bearer {api_token}"
    payload = {
        "model": modelVersion,
        "messages": [{"role": "system", "content": systemPrompt},
            {"role": "user", "content": userPrompt}],
{{ body_options_block }}
    }
    responseObject = requests.post(
        modelEndpoint,
        headers=headers,
        json=payload,
        timeout={{ timeout_s }},
    )
    try:
        responseJson = responseObject.json()
    except Exception:
        logger.error(f"Non-JSON response: {responseObject.status_code} - {responseObject.text}")
        raise
    if responseObject.status_code < 200 or responseObject.status_code >= 300:
        logger.error(f"HTTP {responseObject.status_code}: {json.dumps(responseJson)}")
        if responseObject.status_code in (401, 403):
            # SCR shows the caller the failing source line, not the message:
            # the line itself names the remedy.
            raise RuntimeError("The inference server refused the token - set {{ token_env }} in the key Secret of the container (mdb deploy prints the command)")
        raise RuntimeError(f"Request failed: {responseObject.status_code}")
    choice = responseJson['choices'][0]
    response = choice['message'].get('content') or ''
    if not response.strip() and choice.get('finish_reason') == 'length':
        # A reasoning model (gpt-oss, Qwen3, ...) can spend the whole output
        # budget on its reasoning: the server answers 200 with no content.
        # Fail with the remedy instead of returning an empty answer.
        logger.error(f"No answer within the output budget: {json.dumps(responseJson.get('usage', {}))}")
        raise RuntimeError("No answer: the output token limit was reached before the answer - raise max_tokens or lower reasoning_effort")
    usage = responseJson.get('usage', {}) or {}
    prompt_length = usage.get('prompt_tokens', 0)
    output_length = usage.get('completion_tokens', 0)
    run_time = time.time() - started_timestamp
    # Logging the response
    logger.info(f"prompt_length: {prompt_length}")
    logger.info(f"output_length: {output_length}")
    logger.info(f"run_time: {run_time}")
    logger.info(f"response: {response}")
    return response, run_time, prompt_length, output_length
