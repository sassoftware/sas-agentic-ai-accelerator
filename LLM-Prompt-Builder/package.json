{
  "name": "llm-prompt-builder",
  "version": "2.0.4",
  "description": "Standalone LLM Prompt Builder — a no-code prompt engineering UI for SAS Viya, deployable as a single-file embed in SAS Visual Analytics.",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "dev:rag": "vite --config vite.rag.config.ts",
    "build:rag": "tsc --noEmit && vite build --config vite.rag.config.ts"
  },
  "dependencies": {
    "bootstrap": "^5.3.8",
    "dompurify": "^3.4.14",
    "marked": "^18.0.11"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
